          "type": "integer"
        }
      },
      "required": [
        "nodes_removed",
        "edges_removed",
        "nodes_archived"
      ],
      "type": "object"
    },
    "ScenePose": {
      "description": "A scene object's composed world transform (`Method::WorldTransform`) -- the wire\nprojection of `eg_core::scene::Pose`, the same `{translation, rotation, scale}` object a\nscene node stores under its `pose` property.",
      "properties": {
        "rotation": {
          "$ref": "#/$defs/SceneQuat"
        },
        "scale": {
          "$ref": "#/$defs/SceneVec3"
        },
        "translation": {
          "$ref": "#/$defs/SceneVec3"
        }
      },
      "required": [
        "translation",
        "rotation",
        "scale"
      ],
      "type": "object"
    },
