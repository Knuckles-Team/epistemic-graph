        "confirmed"
      ],
      "type": "object"
    },
    "ContinuousQueryResult": {
      "description": "Current result of a continuous query — the incrementally-maintained value plus the\nCDC `seq` it reflects (so a reader knows how current it is).",
      "properties": {
