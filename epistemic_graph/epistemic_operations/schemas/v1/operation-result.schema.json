{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:epistemic-operations:v1:operation-result",
  "title": "OperationResult",
  "description": "Shared structured success, failure, and placement-redirect boundary without raw exception, endpoint, credential, identity, or local-path material.",
  "type": "object",
  "additionalProperties": false,
  "x-python-model": "OperationResult",
  "x-rust-type": "OperationResult",
  "$defs": {
    "operation_error": {
      "type": "object",
      "additionalProperties": false,
      "x-python-model": "OperationError",
      "x-rust-type": "OperationError",
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "retryable": {"type": "boolean"},
        "correlation_id": {"type": "string", "minLength": 1},
        "detail_ref": {"type": ["string", "null"], "minLength": 1}
      },
      "required": ["code", "retryable", "correlation_id", "detail_ref"]
    },
    "operation_redirect": {
      "type": "object",
      "additionalProperties": false,
      "x-python-model": "OperationRedirect",
      "x-rust-type": "OperationRedirect",
      "properties": {
        "kind": {"enum": ["placement"]},
        "target_ref": {"type": "string", "minLength": 1},
        "group": {"type": "integer", "minimum": 0},
        "epoch": {"type": "integer", "minimum": 0},
        "fencing_token": {"type": "integer", "minimum": 0},
        "leader_ref": {"type": ["string", "null"], "minLength": 1}
      },
      "required": ["kind", "target_ref", "group", "epoch", "fencing_token", "leader_ref"]
    }
  },
  "properties": {
    "schema_version": {"const": "1"},
    "operation_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["succeeded", "failed", "redirected"]},
    "result_kind": {"type": ["string", "null"], "minLength": 1},
    "result_ref": {"type": ["string", "null"], "minLength": 1},
    "error": {
      "oneOf": [
        {"$ref": "#/$defs/operation_error"},
        {"type": "null"}
      ]
    },
    "redirect": {
      "oneOf": [
        {"$ref": "#/$defs/operation_redirect"},
        {"type": "null"}
      ]
    }
  },
  "required": [
    "schema_version",
    "operation_id",
    "status",
    "result_kind",
    "result_ref",
    "error",
    "redirect"
  ]
}
