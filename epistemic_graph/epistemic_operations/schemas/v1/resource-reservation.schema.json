{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:epistemic-operations:v1:resource-reservation",
  "title": "ResourceReservationRequest",
  "description": "Versioned native WorkItem resource reservation request. The engine re-reads the WorkItem admission extension and treats caller fields as immutable-input assertions.",
  "type": "object",
  "additionalProperties": false,
  "x-python-model": "ResourceReservationRequest",
  "x-rust-type": "ResourceReservationRequest",
  "$defs": {
    "resource_capacity_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "x-python-model": "ResourceCapacitySnapshot",
      "x-rust-type": "ResourceCapacitySnapshot",
      "properties": {
        "cpu_weight": {"type": "integer", "minimum": 0},
        "memory_mib": {"type": "integer", "minimum": 0},
        "disk_mib": {"type": "integer", "minimum": 0},
        "process_slots": {"type": "integer", "minimum": 0},
        "host_revision": {"type": "integer", "minimum": 0}
      },
      "required": ["cpu_weight", "memory_mib", "disk_mib", "process_slots", "host_revision"]
    },
    "resource_reservation_record": {
      "type": "object",
      "additionalProperties": false,
      "x-python-model": "ResourceReservationRecord",
      "x-rust-type": "ResourceReservationRecord",
      "properties": {
        "reservation_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "tenant_ref": {"type": "string", "minLength": 1, "maxLength": 256},
        "owner_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "work_item_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "fence": {"type": "string", "minLength": 1, "maxLength": 256},
        "attempt": {"type": "integer", "minimum": 1},
        "lease_epoch": {"type": "integer", "minimum": 0},
        "fencing_token": {"type": "integer", "minimum": 0},
        "input_fingerprint": {"type": "string", "pattern": "^v1:[0-9a-f]{64}$"},
        "host_ref": {"type": "string", "minLength": 1, "maxLength": 256},
        "profile_name": {"type": "string", "minLength": 1, "maxLength": 256},
        "profile_version": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^(0|[1-9][0-9]*)$"},
        "requirement": {"$ref": "#/$defs/resource_requirement"},
        "capacity_snapshot": {"$ref": "#/$defs/resource_capacity_snapshot"},
        "selected_target": {"$ref": "#/$defs/resource_target_snapshot"},
        "target_kind": {"enum": ["local", "inventory_alias"]},
        "target_alias": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
        "repository_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "branch": {"type": "string", "minLength": 1, "maxLength": 256},
        "concurrency_key": {"type": "string", "minLength": 1, "maxLength": 256},
        "concurrency_limit": {"type": ["integer", "null"], "minimum": 1},
        "repository_exclusive": {"type": "boolean"},
        "branch_exclusive": {"type": "boolean"},
        "required_labels": {"type": "array", "maxItems": 128, "items": {"type": "string", "minLength": 1, "maxLength": 256}, "uniqueItems": true},
        "anti_affinity": {"type": "array", "maxItems": 128, "items": {"type": "string", "minLength": 1, "maxLength": 256}, "uniqueItems": true},
        "fairness_group": {"type": "string", "minLength": 1, "maxLength": 256},
        "fairness_cost": {"type": "integer", "minimum": 1},
        "disk_low_watermark_mib": {"type": ["integer", "null"], "minimum": 0},
        "disk_high_watermark_mib": {"type": ["integer", "null"], "minimum": 0},
        "disk_policy_key": {"type": "string", "minLength": 1, "maxLength": 256},
        "reserved_at_ms": {"type": "integer", "minimum": 0},
        "expires_at_ms": {"type": "integer", "minimum": 1},
        "expected_host_revision": {"type": ["integer", "null"], "minimum": 1},
        "expected_lifecycle_revision": {"type": ["integer", "null"], "minimum": 0},
        "state": {"enum": ["reserved", "released", "reclaimed", "expired", "superseded", "absent"]},
        "revision": {"type": "integer", "minimum": 1},
        "lifecycle_revision": {"type": "integer", "minimum": 0},
        "tombstone": {"type": "boolean"}
      },
      "required": ["reservation_id", "tenant_ref", "owner_id", "work_item_id", "fence", "attempt", "lease_epoch", "fencing_token", "input_fingerprint", "host_ref", "profile_name", "profile_version", "requirement", "capacity_snapshot", "selected_target", "target_kind", "target_alias", "repository_id", "branch", "concurrency_key", "concurrency_limit", "repository_exclusive", "branch_exclusive", "required_labels", "anti_affinity", "fairness_group", "fairness_cost", "disk_low_watermark_mib", "disk_high_watermark_mib", "disk_policy_key", "reserved_at_ms", "expires_at_ms", "expected_host_revision", "expected_lifecycle_revision", "state", "revision", "lifecycle_revision", "tombstone"]
    },
    "resource_reservation_result": {
      "type": "object",
      "additionalProperties": false,
      "x-python-model": "ResourceReservationResult",
      "x-rust-type": "ResourceReservationResult",
      "properties": {
        "schema_version": {"const": "1"},
        "decision": {"enum": ["accepted", "idempotent", "stale", "conflict", "input_conflict", "capacity", "policy", "drained", "quarantined", "stale_host", "labels", "anti_affinity", "disk", "concurrency", "exclusivity", "not_found"]},
        "reservation_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
        "work_item_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "attempt": {"type": "integer", "minimum": 1},
        "lease_epoch": {"type": "integer", "minimum": 0},
        "fencing_token": {"type": "integer", "minimum": 0},
        "lifecycle_revision": {"type": "integer", "minimum": 0},
        "host_ref": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
        "host_revision": {"type": "integer", "minimum": 0},
        "record": {"oneOf": [{"$ref": "#/$defs/resource_reservation_record"}, {"type": "null"}]},
        "state": {"enum": ["reserved", "released", "reclaimed", "expired", "superseded", "absent"]},
        "held_cpu_weight": {"type": "integer", "minimum": 0},
        "held_memory_mib": {"type": "integer", "minimum": 0},
        "held_disk_mib": {"type": "integer", "minimum": 0},
        "held_process_slots": {"type": "integer", "minimum": 0},
        "fairness_debt": {"type": "integer", "minimum": 0},
        "tombstone": {"type": "boolean"},
        "changed_work_item_ids": {"type": "array", "maxItems": 128, "items": {"type": "string", "minLength": 1, "maxLength": 256}, "uniqueItems": true}
      },
      "required": ["schema_version", "decision", "reservation_id", "work_item_id", "attempt", "lease_epoch", "fencing_token", "lifecycle_revision", "host_ref", "host_revision", "record", "state", "held_cpu_weight", "held_memory_mib", "held_disk_mib", "held_process_slots", "fairness_debt", "tombstone", "changed_work_item_ids"]
    },
    "resource_target_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "x-python-model": "ResourceTargetSnapshot",
      "x-rust-type": "ResourceTargetSnapshot",
      "properties": {
        "kind": {"enum": ["local", "inventory_alias"]},
        "alias": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
        "capability_labels": {"type": "array", "maxItems": 128, "items": {"type": "string", "minLength": 1, "maxLength": 256}, "uniqueItems": true}
      },
      "required": ["kind", "alias", "capability_labels"]
    },
    "resource_requirement": {
      "type": "object",
      "additionalProperties": false,
      "x-python-model": "ResourceRequirement",
      "x-rust-type": "ResourceRequirement",
      "properties": {
        "cpu_weight": {"type": "integer", "minimum": 1},
        "memory_mib": {"type": "integer", "minimum": 1},
        "disk_mib": {"type": "integer", "minimum": 1},
        "process_slots": {"type": "integer", "minimum": 1}
      },
      "required": ["cpu_weight", "memory_mib", "disk_mib", "process_slots"]
    }
  },
  "properties": {
    "schema_version": {"const": "1"},
    "tenant_ref": {"type": "string", "minLength": 1, "maxLength": 256},
    "work_item_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "owner_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "fence": {"type": "string", "minLength": 1, "maxLength": 256},
    "lease_epoch": {"type": "integer", "minimum": 0},
    "fencing_token": {"type": "integer", "minimum": 0},
    "attempt": {"type": "integer", "minimum": 1},
    "reservation_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "input_fingerprint": {"type": "string", "pattern": "^v1:[0-9a-f]{64}$"},
    "profile_name": {"type": "string", "minLength": 1, "maxLength": 256},
    "profile_version": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^(0|[1-9][0-9]*)$"},
    "host_ref": {"type": "string", "minLength": 1, "maxLength": 256},
    "requirement": {"$ref": "#/$defs/resource_requirement"},
    "target_kind": {"enum": ["local", "inventory_alias"]},
    "target_alias": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
    "repository_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "branch": {"type": "string", "minLength": 1, "maxLength": 256},
    "concurrency_key": {"type": "string", "minLength": 1, "maxLength": 256},
    "concurrency_limit": {"type": ["integer", "null"], "minimum": 1},
    "repository_exclusive": {"type": "boolean"},
    "branch_exclusive": {"type": "boolean"},
    "required_labels": {"type": "array", "maxItems": 128, "items": {"type": "string", "minLength": 1, "maxLength": 256}, "uniqueItems": true},
    "anti_affinity": {"type": "array", "maxItems": 128, "items": {"type": "string", "minLength": 1, "maxLength": 256}, "uniqueItems": true},
    "fairness_group": {"type": "string", "minLength": 1, "maxLength": 256},
    "fairness_cost": {"type": "integer", "minimum": 1},
    "disk_low_watermark_mib": {"type": ["integer", "null"], "minimum": 0},
    "disk_high_watermark_mib": {"type": ["integer", "null"], "minimum": 0},
    "disk_policy_key": {"type": "string", "minLength": 1, "maxLength": 256},
    "reserved_at_ms": {"type": "integer", "minimum": 0},
    "expires_at_ms": {"type": "integer", "minimum": 1},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 256},
    "now_ms": {"type": "integer", "minimum": 0},
    "expected_host_revision": {"type": ["integer", "null"], "minimum": 0},
    "expected_lifecycle_revision": {"type": ["integer", "null"], "minimum": 0}
  },
  "required": ["schema_version", "tenant_ref", "work_item_id", "owner_id", "fence", "lease_epoch", "fencing_token", "attempt", "reservation_id", "input_fingerprint", "profile_name", "profile_version", "host_ref", "requirement", "target_kind", "target_alias", "repository_id", "branch", "concurrency_key", "concurrency_limit", "repository_exclusive", "branch_exclusive", "required_labels", "anti_affinity", "fairness_group", "fairness_cost", "disk_low_watermark_mib", "disk_high_watermark_mib", "disk_policy_key", "reserved_at_ms", "expires_at_ms", "idempotency_key", "now_ms", "expected_host_revision", "expected_lifecycle_revision"]
}
