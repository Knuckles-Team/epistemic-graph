# epistemic-graph environment configuration
PYTHONPATH=.

# Runtime environment settings
GRAPH_SERVICE_AUTH_SECRET=changeme
GRAPH_SERVICE_SOCKET=/tmp/epistemic_graph.sock
XDG_RUNTIME_DIR=/tmp
PATH=/usr/local/bin:/usr/bin:/bin
UID=1000

# SPARQL SERVICE federation allowlist (CONCEPT:EG-052, feature `sparql-service`).
# Comma-separated allowed endpoint hosts / scheme://host:port origins. Empty/unset =>
# SERVICE disabled (fail-closed). Internal (loopback/link-local/RFC-1918) hosts are
# refused unless listed as an exact IP literal.
# EPISTEMIC_GRAPH_SPARQL_SERVICE_ALLOW=dbpedia.org,query.wikidata.org

# OpenTelemetry OTLP span export (CONCEPT:EG-091, feature `otel`). When set AND the
# binary is built `--features otel`, a batch OTLP span exporter is layered on top of
# the existing tracing subscriber. Unset / non-otel build => no exporter (unchanged).
# EPISTEMIC_GRAPH_OTLP_ENDPOINT=http://127.0.0.1:4317

# Observability log-ingestion HTTP listener (CONCEPT:EG-160/161, feature `obs`).
# When set AND the binary is built `--features obs`, a hand-rolled HTTP listener binds
# this address and accepts log records over OTLP/HTTP (`POST /v1/logs`), Elasticsearch
# `_bulk`/`<stream>/_doc`, and JSON-lines (`POST /`), landing them in eg-tsdb series +
# per-stream eg-text full-text indices and rolling Parquet segments into the blob CAS.
# Unset / non-obs build => no listener (unchanged). Multi-tenant by stream.
# EPISTEMIC_GRAPH_OBS_ADDR=127.0.0.1:5080
# Per-stream buffered-record count that triggers a Parquet segment flush (default 1024).
# EPISTEMIC_GRAPH_OBS_FLUSH_RECORDS=1024

# MySQL / MariaDB wire-protocol listener (CONCEPT:EG-076, feature `mysql-wire`).
# When set AND the binary is built `--features mysql-wire`, a hand-rolled MySQL wire
# listener (Handshake v10 + mysql_native_password + COM_QUERY) binds this address and a
# MySQL driver/ORM/`mysql` CLI runs SQL over `nodes`/`edges` via the SAME EG-074
# WireSession core as pgwire (text protocol; prepared-statement binary protocol deferred).
# Unset / non-mysql-wire build => no listener (unchanged).
# EPISTEMIC_GRAPH_MYSQL_ADDR=127.0.0.1:3306
# Default graph a fresh MySQL connection runs against when the connect `database` is unset.
# EPISTEMIC_GRAPH_MYSQL_GRAPH=__commons__
# MySQL auth mode: `native` (mysql_native_password) or `trust` (no auth, dev). DEFAULT =
# native when GRAPH_SERVICE_AUTH_SECRET is set, else trust. The per-user password is
# hex(HMAC-SHA256(secret, "mysql:"+user)); a successful login sets the connection's ACL actor.
# EPISTEMIC_GRAPH_MYSQL_AUTH=native

# Slow-query log threshold in ms (CONCEPT:EG-091). Positive integer => any query
# slower than this is logged (tracing::warn! target epistemic_graph::slow_query) and
# counted in epistemic_graph_slow_query_total. Absent / 0 => disabled.
# EPISTEMIC_GRAPH_SLOW_QUERY_MS=500
