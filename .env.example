# epistemic-graph environment configuration
PYTHONPATH=.

# Runtime environment settings
GRAPH_SERVICE_AUTH_SECRET=changeme
GRAPH_SERVICE_SOCKET=/tmp/epistemic_graph.sock
XDG_RUNTIME_DIR=/tmp
PATH=/usr/local/bin:/usr/bin:/bin
UID=1000

# SPARQL SERVICE federation allowlist (CONCEPT:EG-052, feature `sparql-service`).
# Comma-separated allowed endpoint hosts / scheme://host:port origins. Empty/unset =>
# SERVICE disabled (fail-closed). Internal (loopback/link-local/RFC-1918) hosts are
# refused unless listed as an exact IP literal.
# EPISTEMIC_GRAPH_SPARQL_SERVICE_ALLOW=dbpedia.org,query.wikidata.org
