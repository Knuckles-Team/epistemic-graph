# Which open incidents or changes touch a service a customer contract depends
# on? Classes only (EG-CQ-XSRC-R008.3.3): :Incident on the :ApplicationEvent
# path, canonical :Change on the :BusinessProcess path, and no source,
# endpoint or connector named here.
PREFIX : <http://knuckles.team/kg#>
PREFIX infra: <http://knuckles.team/kg/infrastructure#>

SELECT ?event ?service ?contract WHERE {
  { ?event a :Incident } UNION { ?event a :Change } .
  ?event :affectsEntity ?service .
  ?service a infra:Service .
  ?contract a :CustomerContract ;
            :coversService ?service .
}
