# The supply-chain impact question, classes only (MEDULLA-CQ-XSRC-R005.2).
#
# Source choice comes from the ontology's vg:SourceAuthority rows, never from
# this text: no source, endpoint or connector is named here. A test fails if
# this file gains a connector name.
PREFIX : <http://knuckles.team/kg#>
PREFIX infra: <http://knuckles.team/kg/infrastructure#>

SELECT ?service ?component ?supplier ?vulnerability WHERE {
  ?service a infra:Service ;
           :usesComponent ?version .
  ?version :supplyChainVersionOf ?component .
  ?component a :SoftwareComponent ;
             :publishedBy ?supplier .
  ?supplier a :Supplier .
  OPTIONAL {
    ?vulnerability a :Vulnerability ;
                   :affectsComponent ?version .
  }
}
