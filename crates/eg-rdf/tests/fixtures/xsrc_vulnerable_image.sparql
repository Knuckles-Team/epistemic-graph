# Which services are exposed by a vulnerability in an image we deploy?
# Classes only (EG-CQ-XSRC-R008.1.1): the deployed-image filter reuses the
# existing :deployedAs/:usesImage/:containsComponent terms, and no source,
# endpoint or connector is named here.
PREFIX : <http://knuckles.team/kg#>
PREFIX infra: <http://knuckles.team/kg/infrastructure#>

SELECT ?service ?image ?workload ?version ?vulnerability WHERE {
  ?image a infra:ContainerImage .
  ?workload a infra:Workload ;
            :usesImage ?image .
  ?service a infra:Service ;
           :deployedAs ?workload .
  ?image :containsComponent ?version .
  ?vulnerability a :Vulnerability ;
                 :affectsComponent ?version .
}
