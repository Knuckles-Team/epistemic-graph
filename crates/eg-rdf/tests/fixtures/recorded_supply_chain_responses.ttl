@prefix : <http://knuckles.team/kg#> .
@prefix infra: <http://knuckles.team/kg/infrastructure#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix ex: <http://knuckles.team/xsrc/recorded#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Recorded connector responses for the supply-chain impact question
# (MEDULLA-CQ-XSRC-R007.1): one record set per connected source, no network, no
# live credentials. Each record carries the provenance the connector's
# virtual mapping attaches at query time (dc:source, dc:identifier, dc:date).
# Frozen as-of: 2026-10-27T00:00:00Z.

# --- erpnext-mcp: the supplier and the item it supplies -------------------

ex:supplier-acme a :Supplier ;
    rdfs:label "Acme Cloud, Inc." ;
    dc:source "erpnext-mcp" ;
    dc:identifier "erpnext:rec:supplier-sup-42" ;
    dc:date "2026-10-27T00:00:00Z"^^xsd:dateTime .

ex:item-acme-openssl a :SupplyChainItem ;
    rdfs:label "openssl 1.1.1k" ;
    dc:source "erpnext-mcp" ;
    dc:identifier "erpnext:rec:item-item-17" ;
    dc:date "2026-10-27T00:00:00Z"^^xsd:dateTime .

ex:supplier-acme :suppliesItem ex:item-acme-openssl .

# --- dockerhub-mcp: the image, its publisher and its SBOM component --------

ex:image-acme-nginx a infra:ContainerImage ;
    rdfs:label "acme/nginx" ;
    dc:source "dockerhub-mcp" ;
    dc:identifier "dockerhub:rec:image-acme-nginx" ;
    dc:date "2026-10-27T00:00:00Z"^^xsd:dateTime .

ex:component-nginx a :SoftwareComponent ;
    rdfs:label "nginx" ;
    dc:source "dockerhub-mcp" ;
    dc:identifier "dockerhub:rec:component-nginx" ;
    dc:date "2026-10-27T00:00:00Z"^^xsd:dateTime .

ex:version-nginx-118 a :ComponentVersion ;
    :versionString "1.18.0" ;
    :supplyChainVersionOf ex:component-nginx ;
    dc:source "dockerhub-mcp" ;
    dc:identifier "dockerhub:rec:sbom-nginx-118" ;
    dc:date "2026-10-27T00:00:00Z"^^xsd:dateTime .

ex:image-acme-nginx :containsComponent ex:version-nginx-118 .
ex:component-nginx :publishedBy ex:supplier-acme .

# --- gitlab-mcp: the vulnerability finding ---------------------------------

ex:vuln-nginx a :Vulnerability ;
    :cveId "CVE-2021-23017" ;
    :severity "medium" ;
    :affectsComponent ex:version-nginx-118 ;
    dc:source "gitlab-mcp" ;
    dc:identifier "gitlab:rec:finding-2021-23017" ;
    dc:date "2026-10-27T00:00:00Z"^^xsd:dateTime .

ex:image-acme-nginx :hasVulnerability ex:vuln-nginx .

# --- container-manager-mcp: the deployed workload and its service ----------

ex:workload-checkout a infra:Workload ;
    rdfs:label "checkout" ;
    :usesImage ex:image-acme-nginx ;
    dc:source "container-manager-mcp" ;
    dc:identifier "cm:rec:workload-checkout" ;
    dc:date "2026-10-27T00:00:00Z"^^xsd:dateTime .

ex:service-checkout a infra:Service ;
    rdfs:label "checkout" ;
    :deployedAs ex:workload-checkout ;
    :usesComponent ex:version-nginx-118 ;
    dc:source "container-manager-mcp" ;
    dc:identifier "cm:rec:service-checkout" ;
    dc:date "2026-10-27T00:00:00Z"^^xsd:dateTime .

# --- uptime-mcp: the live health record for the same service ---------------

ex:service-checkout :status "up" ;
    dc:source "uptime-mcp" ;
    dc:identifier "uptime:rec:check-checkout" ;
    dc:date "2026-10-27T00:00:00Z"^^xsd:dateTime .
