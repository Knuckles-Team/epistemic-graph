# Entity-resolution blocking keys for the supply-chain concepts
# (EG-SUPPLY-VOCAB-R007.1).
#
# The plan.md table as a data fixture: one key set per concept, strongest key
# first. Mechanism: EG-UNIFIED-DATA-PLANE-R030 (blocking, field similarity,
# Fellegi-Sunter, proposals inactive until approved). A digest key is exact;
# a name-only key is always a proposal, never auto-approved.

@prefix : <http://knuckles.team/kg#> .
@prefix infra: <http://knuckles.team/kg/infrastructure#> .
@prefix ex: <http://knuckles.team/test/supply-chain#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:BlockingKeySet a owl:Class ;
    rdfs:label "blocking key set" ;
    rdfs:comment "The blocking keys that pre-filter entity-resolution candidates for one concept, strongest first." .

ex:BlockingKey a owl:Class ;
    rdfs:label "blocking key" ;
    rdfs:comment "One candidate field one key set compares: a digest key is exact, a name-only key is a proposal." .

ex:appliesTo a owl:ObjectProperty ;
    rdfs:label "applies to" ;
    rdfs:comment "The concept one blocking key set blocks." ;
    rdfs:domain ex:BlockingKeySet .

ex:hasKey a owl:ObjectProperty ;
    rdfs:label "has key" ;
    rdfs:comment "One blocking key of one set, strongest first." ;
    rdfs:domain ex:BlockingKeySet ;
    rdfs:range ex:BlockingKey .

# kg:Supplier: erpnext Supplier.supplier_name, leanix Provider name,
# dockerhub Organization/namespace, github/gitlab owner.
ex:supplierKeys a ex:BlockingKeySet ;
    rdfs:label "kg:Supplier blocking keys" ;
    ex:appliesTo :Supplier ;
    ex:hasKey ex:supplierLegalName, ex:supplierWebDomain, ex:supplierNamespaceSlug .

ex:supplierLegalName a ex:BlockingKey ;
    rdfs:label "normalized legal name" .

ex:supplierWebDomain a ex:BlockingKey ;
    rdfs:label "web domain" .

ex:supplierNamespaceSlug a ex:BlockingKey ;
    rdfs:label "namespace slug" .

# infra:Service: uptime monitor, container-manager workload/K8sService,
# portainer Service, leanix Application, servicenow CI.
ex:serviceKeys a ex:BlockingKeySet ;
    rdfs:label "infra:Service blocking keys" ;
    ex:appliesTo infra:Service ;
    ex:hasKey ex:serviceName, ex:serviceUrlHostname, ex:serviceNamespaceName .

ex:serviceName a ex:BlockingKey ;
    rdfs:label "normalized service name" .

ex:serviceUrlHostname a ex:BlockingKey ;
    rdfs:label "hostname from monitor URL" .

ex:serviceNamespaceName a ex:BlockingKey ;
    rdfs:label "namespace plus name" .

# infra:Host: systems-manager HardwareNode, fan-manager ManagedHost,
# ERPNext asset, CMDB CI.
ex:hostKeys a ex:BlockingKeySet ;
    rdfs:label "infra:Host blocking keys" ;
    ex:appliesTo infra:Host ;
    ex:hasKey ex:hostHostname, ex:hostBmcAddress, ex:hostSerialNumber .

ex:hostHostname a ex:BlockingKey ;
    rdfs:label "hostname" .

ex:hostBmcAddress a ex:BlockingKey ;
    rdfs:label "BMC address" .

ex:hostSerialNumber a ex:BlockingKey ;
    rdfs:label "serial number" .

# infra:ContainerImage: dockerhub Repository/tag, container-manager image,
# portainer Image.
ex:imageKeys a ex:BlockingKeySet ;
    rdfs:label "infra:ContainerImage blocking keys" ;
    ex:appliesTo infra:ContainerImage ;
    ex:hasKey ex:imageReference, ex:imageDigest .

ex:imageReference a ex:BlockingKey ;
    rdfs:label "registry/repository:tag" .

ex:imageDigest a ex:BlockingKey ;
    rdfs:label "digest (exact)" .

# kg:Customer: erpnext Customer, salesforce Account, twenty Company.
ex:customerKeys a ex:BlockingKeySet ;
    rdfs:label "kg:Customer blocking keys" ;
    ex:appliesTo :Customer ;
    ex:hasKey ex:customerName, ex:customerDomain .

ex:customerName a ex:BlockingKey ;
    rdfs:label "normalized name" .

ex:customerDomain a ex:BlockingKey ;
    rdfs:label "domain" .
