# Recorded virtual-graph mapping for the `arr` connector (EG-MEDIA-VOCAB-R005.1,
# EG-CQ-CONN-R005). The rows are the `Connector mapping tables` entry for arr
# in specs/media-and-personal-vocabulary/plan.md (operation -> class/property
# -> contract kind), written as `vg:VirtualMapping` rows over the `vg:`
# vocabulary in virtual_graph-v1.ttl and shaped by virtual_graph-v1.shapes.ttl.
# `mv:` is a documentation prefix for this section of the shared
# `http://knuckles.team/kg#` namespace; every ontology IRI stays in `:`.
#
# The metadata contract is the discovery of the recorded response
# (arr_response.json, same directory): the discoveredEntity / discoveredField /
# discoveredOperation values below are exactly the names that response uses,
# and vg:contentDigest is sha256 over its bytes.

@prefix :    <http://knuckles.team/kg#> .
@prefix vg:  <http://knuckles.team/kg/virtual-graph#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix f:   <urn:eg-media-vocab:arr/> .

f:connection a vg:SourceConnection ;
    vg:sourceKind "mcp" ;
    vg:declaredCapability "read" ;
    vg:endpointRef [ a vg:EndpointRef ; vg:url "https://mcp.example.invalid/arr" ] .

f:contract a vg:MetadataContract ;
    vg:contractSource f:connection ;
    vg:schemaVersion "1" ;
    vg:contentDigest "sha256:6a4f43ccf1f5dbf3386f92d74a8044adcb7f96d52b3c7facdbaf109f460bc2ca" ;
    vg:discoveredEntity "Movie", "Series", "Episode", "WantedMissing", "QueueItem", "HistoryEntry", "Indexer", "Request", "Album", "Track", "Artist" ;
    vg:discoveredField "id", "title", "tmdbId", "tvdbId", "monitored", "hasFile", "state", "work", "downloadId", "movie", "indexer", "eventType", "name", "enabled", "musicBrainzId", "requestedBy" ;
    vg:discoveredOperation "radarr_action/get_movie", "radarr_action/get_wanted_missing", "radarr_action/get_queue", "radarr_action/get_history", "radarr_action/get_history_movie", "sonarr_action/get_series", "sonarr_action/get_episode", "sonarr_action/get_wanted_missing", "sonarr_action/get_queue", "sonarr_action/get_history_series", "lidarr_action/get_album", "lidarr_action/get_track", "lidarr_action/get_wanted_missing", "prowlarr_action/get_indexer", "prowlarr_action/get_indexerstats", "seerr_action/get_request" .

# radarr_action/get_movie
f:row-movie a vg:VirtualMapping ;
    vg:mapsContract f:contract ;
    vg:mapsOntologyClass :Film ;
    vg:mapsEntity "Movie" ;
    vg:keyField "id" ;
    vg:approved "true"^^xsd:boolean ;
    vg:hasPredicateFieldPair [
        a vg:PredicateFieldPair ;
        vg:predicate :title ;
        vg:field "title"
    ], [
        a vg:PredicateFieldPair ;
        vg:predicate :tmdbId ;
        vg:field "tmdbId"
    ], [
        a vg:PredicateFieldPair ;
        vg:predicate :isMonitored ;
        vg:field "monitored"
    ], [
        a vg:PredicateFieldPair ;
        vg:predicate :hasFile ;
        vg:field "hasFile"
    ] .

