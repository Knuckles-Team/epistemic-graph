# radarr_action/get_wanted_missing, sonarr_action/get_wanted_missing
f:row-wanted-missing a vg:VirtualMapping ;
    vg:mapsContract f:contract ;
    vg:mapsOntologyClass :DownloadRequest ;
    vg:mapsEntity "WantedMissing" ;
    vg:keyField "id" ;
    vg:approved "true"^^xsd:boolean ;
    vg:hasPredicateFieldPair [
        a vg:PredicateFieldPair ;
        vg:predicate :downloadRequestState ;
        vg:field "state"
    ], [
        a vg:PredicateFieldPair ;
        vg:predicate :requestsWork ;
        vg:field "work"
    ] .

# radarr_action/get_queue, sonarr_action/get_queue: the queue downloadId is the
# torrent info-hash, case-folded on the way in (R003.2 normalisation).
f:row-queue-item a vg:VirtualMapping ;
    vg:mapsContract f:contract ;
    vg:mapsOntologyClass :DownloadTransfer ;
    vg:mapsEntity "QueueItem" ;
    vg:keyField "downloadId" ;
    vg:approved "true"^^xsd:boolean ;
    vg:hasPredicateFieldPair [
        a vg:PredicateFieldPair ;
        vg:predicate :infoHash ;
        vg:field "downloadId"
    ], [
        a vg:PredicateFieldPair ;
        vg:predicate :transferOf ;
        vg:field "work"
    ] .

# radarr_action/get_history, get_history_movie; sonarr_action/get_history_series
f:row-history-entry a vg:VirtualMapping ;
    vg:mapsContract f:contract ;
    vg:mapsOntologyClass :GrabEvent ;
    vg:mapsEntity "HistoryEntry" ;
    vg:keyField "id" ;
    vg:approved "true"^^xsd:boolean ;
    vg:hasPredicateFieldPair [
        a vg:PredicateFieldPair ;
        vg:predicate :grabOf ;
        vg:field "movie"
    ], [
        a vg:PredicateFieldPair ;
        vg:predicate :grabbedFromIndexer ;
        vg:field "indexer"
    ] .

