    ], [
        a vg:PredicateFieldPair ;
        vg:predicate :tmdbId ;
        vg:field "tmdbId"
    ], [
        a vg:PredicateFieldPair ;
        vg:predicate :tvdbId ;
        vg:field "tvdbId"
    ] .

