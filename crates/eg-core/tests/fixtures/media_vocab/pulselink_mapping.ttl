# Recorded virtual-graph mapping for the `pulselink` connector
# (pulselink-mcp; EG-MEDIA-VOCAB-R016.2, EG-CQ-CONN-R050). The rows are the
# `Connector mapping tables` entry for pulselink in
# specs/media-and-personal-vocabulary/plan.md (operation -> class/property ->
# contract kind), written as `vg:VirtualMapping` rows over the `vg:` vocabulary
# in virtual_graph-v1.ttl. Every ontology IRI stays in `:`; terms are reused
# from media-v1, content-v1, retrieval-v1 and personal-v1, never redeclared.
# The metadata contract is the discovery of the recorded response
# (pulselink_response.json, same directory); vg:contentDigest is sha256 over its bytes.
# `pulse_fetch` and `pulse_list` (article body or listing) add no entity beyond the search result.

@prefix :    <http://knuckles.team/kg#> .
@prefix vg:  <http://knuckles.team/kg/virtual-graph#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix f:   <urn:eg-media-vocab:pulselink/> .

f:connection a vg:SourceConnection ;
    vg:sourceKind "mcp" ;
    vg:declaredCapability "read" ;
    vg:endpointRef [ a vg:EndpointRef ; vg:url "https://mcp.example.invalid/pulselink" ] .

f:contract a vg:MetadataContract ;
    vg:contractSource f:connection ;
    vg:schemaVersion "1" ;
    vg:contentDigest "sha256:e4bcd6f4acc78ae646ec0e96c700600775acbef3830101b95640063009c84e24" ;
    vg:discoveredEntity "SearchResult", "Transcript", "Backend" ;
    vg:discoveredField "id", "name", "publishedAt", "text", "title", "url" ;
    vg:discoveredOperation "pulselink_mcp/pulse_search", "pulselink_mcp/pulse_transcribe", "pulselink_mcp/pulse_status" .

# pulse_search: the video hits
f:row-result a vg:VirtualMapping ;
    vg:mapsContract f:contract ;
    vg:mapsOntologyClass :SearchResult ;
    vg:mapsEntity "SearchResult" ;
    vg:keyField "id" ;
    vg:approved "true"^^xsd:boolean ;
    vg:hasPredicateFieldPair [
        a vg:PredicateFieldPair ;
        vg:predicate :canonicalUrl ;
        vg:field "url"
    ], [
        a vg:PredicateFieldPair ;
        vg:predicate :publishedAt ;
        vg:field "publishedAt"
    ], [
        a vg:PredicateFieldPair ;
        vg:predicate :title ;
        vg:field "title"
    ] .

# pulse_transcribe: the transcript fetched per hit
f:row-transcript a vg:VirtualMapping ;
    vg:mapsContract f:contract ;
    vg:mapsOntologyClass :Transcript ;
    vg:mapsEntity "Transcript" ;
    vg:keyField "id" ;
    vg:approved "true"^^xsd:boolean ;
    vg:hasPredicateFieldPair [
        a vg:PredicateFieldPair ;
        vg:predicate :text ;
        vg:field "text"
    ] .

# pulse_status: the source backend readiness
f:row-backend a vg:VirtualMapping ;
    vg:mapsContract f:contract ;
    vg:mapsOntologyClass :SourceBackend ;
    vg:mapsEntity "Backend" ;
    vg:keyField "id" ;
    vg:approved "true"^^xsd:boolean ;
    vg:hasPredicateFieldPair [
        a vg:PredicateFieldPair ;
        vg:predicate :title ;
        vg:field "name"
    ] .
