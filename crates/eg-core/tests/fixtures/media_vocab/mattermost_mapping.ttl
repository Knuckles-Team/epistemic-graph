# Recorded virtual-graph mapping for the `mattermost` connector
# (mattermost-mcp; EG-MEDIA-VOCAB-R019.2, EG-CQ-CONN-R036). The rows are the
# `Connector mapping tables` entry for mattermost in
# specs/media-and-personal-vocabulary/plan.md (operation -> class/property ->
# contract kind), written as `vg:VirtualMapping` rows over the `vg:` vocabulary
# in virtual_graph-v1.ttl. Every ontology IRI stays in `:`; terms are reused
# from media-v1, content-v1, retrieval-v1 and personal-v1, never redeclared.
# The metadata contract is the discovery of the recorded response
# (mattermost_response.json, same directory); vg:contentDigest is sha256 over its bytes.
# Teams and users reuse the shared :Team and :Person and add no row; files, reactions, webhooks and admin groups are out of scope.

@prefix :    <http://knuckles.team/kg#> .
@prefix vg:  <http://knuckles.team/kg/virtual-graph#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix f:   <urn:eg-media-vocab:mattermost/> .

f:connection a vg:SourceConnection ;
    vg:sourceKind "mcp" ;
    vg:declaredCapability "read" ;
    vg:endpointRef [ a vg:EndpointRef ; vg:url "https://mcp.example.invalid/mattermost" ] .

f:contract a vg:MetadataContract ;
    vg:contractSource f:connection ;
    vg:schemaVersion "1" ;
    vg:contentDigest "sha256:4642ce33322ccadea98130f8954a33826a91b47aa8b8f6dee20c74f3cb6d6e91" ;
    vg:discoveredEntity "Channel", "Message" ;
    vg:discoveredField "create_at", "display_name", "id", "last_post_at", "member_count", "user" ;
    vg:discoveredOperation "mattermost_mcp_channels/get_channel", "mattermost_mcp_channels/get_channel_stats", "mattermost_mcp_posts/get_posts_for_channel" .

# channels, channel stats: the channels
f:row-channel a vg:VirtualMapping ;
    vg:mapsContract f:contract ;
    vg:mapsOntologyClass :MessageChannel ;
    vg:mapsEntity "Channel" ;
    vg:keyField "id" ;
    vg:approved "true"^^xsd:boolean ;
    vg:hasPredicateFieldPair [
        a vg:PredicateFieldPair ;
        vg:predicate :memberCount ;
        vg:field "member_count"
    ], [
        a vg:PredicateFieldPair ;
        vg:predicate :lastPostAt ;
        vg:field "last_post_at"
    ], [
        a vg:PredicateFieldPair ;
        vg:predicate :title ;
        vg:field "display_name"
    ] .

# get_posts_for_channel: the posts and their authors
f:row-message a vg:VirtualMapping ;
    vg:mapsContract f:contract ;
    vg:mapsOntologyClass :ChatMessage ;
    vg:mapsEntity "Message" ;
    vg:keyField "id" ;
    vg:approved "true"^^xsd:boolean ;
    vg:hasPredicateFieldPair [
        a vg:PredicateFieldPair ;
        vg:predicate :postedAt ;
        vg:field "create_at"
    ], [
        a vg:PredicateFieldPair ;
        vg:predicate :postedBy ;
        vg:field "user"
    ] .
