# Recorded virtual-graph mapping for the `scholarx` connector
# (scholarx; EG-MEDIA-VOCAB-R014.2, EG-CQ-CONN-R055). The rows are the
# `Connector mapping tables` entry for scholarx in
# specs/media-and-personal-vocabulary/plan.md (operation -> class/property ->
# contract kind), written as `vg:VirtualMapping` rows over the `vg:` vocabulary
# in virtual_graph-v1.ttl. Every ontology IRI stays in `:`; terms are reused
# from media-v1, content-v1, retrieval-v1 and personal-v1, never redeclared.
# The metadata contract is the discovery of the recorded response
# (scholarx_response.json, same directory); vg:contentDigest is sha256 over its bytes.
# `sx_storage/*` (the local stored copy) is not read-mapped here: its file terms are not declared vocabulary.

@prefix :    <http://knuckles.team/kg#> .
@prefix vg:  <http://knuckles.team/kg/virtual-graph#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix f:   <urn:eg-media-vocab:scholarx/> .

f:connection a vg:SourceConnection ;
    vg:sourceKind "mcp" ;
    vg:declaredCapability "read" ;
    vg:endpointRef [ a vg:EndpointRef ; vg:url "https://mcp.example.invalid/scholarx" ] .

f:contract a vg:MetadataContract ;
    vg:contractSource f:connection ;
    vg:schemaVersion "1" ;
    vg:contentDigest "sha256:195d7a16632bf69d747d6d747e6b76fe7887d4a9a0eda81bad29ddef75e756b3" ;
    vg:discoveredEntity "Paper", "Category", "Source" ;
    vg:discoveredField "arxivId", "citationCount", "doi", "id", "name", "publishedAt", "title" ;
    vg:discoveredOperation "sx_search/search", "sx_search/get_paper", "sx_search/recent", "sx_search/author", "sx_info/categories", "sx_info/sources" .

# sx_search: the papers
f:row-paper a vg:VirtualMapping ;
    vg:mapsContract f:contract ;
    vg:mapsOntologyClass :ScholarlyPaper ;
    vg:mapsEntity "Paper" ;
    vg:keyField "id" ;
    vg:approved "true"^^xsd:boolean ;
    vg:hasPredicateFieldPair [
        a vg:PredicateFieldPair ;
        vg:predicate :doi ;
        vg:field "doi"
    ], [
        a vg:PredicateFieldPair ;
        vg:predicate :arxivId ;
        vg:field "arxivId"
    ], [
        a vg:PredicateFieldPair ;
        vg:predicate :publishedAt ;
        vg:field "publishedAt"
    ], [
        a vg:PredicateFieldPair ;
        vg:predicate :citationCount ;
        vg:field "citationCount"
    ], [
        a vg:PredicateFieldPair ;
        vg:predicate :title ;
        vg:field "title"
    ] .

# sx_info: the categories
f:row-category a vg:VirtualMapping ;
    vg:mapsContract f:contract ;
    vg:mapsOntologyClass :ResearchCategory ;
    vg:mapsEntity "Category" ;
    vg:keyField "id" ;
    vg:approved "true"^^xsd:boolean ;
    vg:hasPredicateFieldPair [
        a vg:PredicateFieldPair ;
        vg:predicate :title ;
        vg:field "name"
    ] .

# sx_info: the paper sources
f:row-source a vg:VirtualMapping ;
    vg:mapsContract f:contract ;
    vg:mapsOntologyClass :PaperSource ;
    vg:mapsEntity "Source" ;
    vg:keyField "id" ;
    vg:approved "true"^^xsd:boolean ;
    vg:hasPredicateFieldPair [
        a vg:PredicateFieldPair ;
        vg:predicate :title ;
        vg:field "name"
    ] .
