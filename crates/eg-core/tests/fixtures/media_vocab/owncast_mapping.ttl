# Recorded virtual-graph mapping for the `owncast` connector
# (owncast-agent; EG-MEDIA-VOCAB-R010.1, EG-CQ-CONN-R045). The rows are the
# `Connector mapping tables` entry for owncast in
# specs/media-and-personal-vocabulary/plan.md (operation -> class/property ->
# contract kind), written as `vg:VirtualMapping` rows over the `vg:` vocabulary
# in virtual_graph-v1.ttl and shaped by virtual_graph-v1.shapes.ttl. `mv:` is a
# documentation prefix for this section of the shared `http://knuckles.team/kg#`
# namespace; every ontology IRI stays in `:`.
#
# The stream's current audience rides the shared :viewerCount on the stream
# node; the viewers-over-time samples are :ViewerSample nodes. The connector
# exposes no past-broadcast list, so the single-source question answers the
# current window only (plan.md, typed abstention otherwise). The metadata
# contract is the discovery of the recorded response
# (owncast_response.json, same directory); vg:contentDigest is sha256 over its
# bytes.

@prefix :    <http://knuckles.team/kg#> .
@prefix vg:  <http://knuckles.team/kg/virtual-graph#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix f:   <urn:eg-media-vocab:owncast/> .

f:connection a vg:SourceConnection ;
    vg:sourceKind "mcp" ;
    vg:declaredCapability "read" ;
    vg:endpointRef [ a vg:EndpointRef ; vg:url "https://mcp.example.invalid/owncast" ] .

f:contract a vg:MetadataContract ;
    vg:contractSource f:connection ;
    vg:schemaVersion "1" ;
    vg:contentDigest "sha256:a2f1d509672886a66aa55dff1410f604253c466a578548c54225f0ddee8677c4" ;
    vg:discoveredEntity "Status", "ViewerSample", "Hardware", "ChatMessage", "Follower" ;
    vg:discoveredField "id", "online", "lastConnectTime", "viewers", "count", "sampledAt", "stream", "cpu", "ram", "content", "created_at", "author", "username" ;
    vg:discoveredOperation "owncast_internal/get_status", "owncast_external/external_get_status", "owncast_internal/get_viewers_over_time", "owncast_internal/get_active_viewers", "owncast_internal/get_hardware_stats", "owncast_chat/get_chat_messages", "owncast_internal/get_followers" .

# owncast_internal/get_status, owncast_external/external_get_status: the
# broadcast stream with its live audience
f:row-status a vg:VirtualMapping ;
    vg:mapsContract f:contract ;
    vg:mapsOntologyClass :BroadcastStream ;
    vg:mapsEntity "Status" ;
    vg:keyField "id" ;
    vg:approved "true"^^xsd:boolean ;
    vg:hasPredicateFieldPair [
        a vg:PredicateFieldPair ;
        vg:predicate :streamOnline ;
        vg:field "online"
    ], [
        a vg:PredicateFieldPair ;
        vg:predicate :lastConnectAt ;
        vg:field "lastConnectTime"
    ], [
        a vg:PredicateFieldPair ;
        vg:predicate :viewerCount ;
        vg:field "viewers"
    ] .

# owncast_internal/get_viewers_over_time, get_active_viewers: the audience
# samples of the current window
f:row-viewer-sample a vg:VirtualMapping ;
    vg:mapsContract f:contract ;
    vg:mapsOntologyClass :ViewerSample ;
    vg:mapsEntity "ViewerSample" ;
    vg:keyField "id" ;
    vg:approved "true"^^xsd:boolean ;
    vg:hasPredicateFieldPair [
        a vg:PredicateFieldPair ;
        vg:predicate :viewerCount ;
        vg:field "count"
    ], [
        a vg:PredicateFieldPair ;
        vg:predicate :sampledAt ;
        vg:field "sampledAt"
    ], [
        a vg:PredicateFieldPair ;
        vg:predicate :sampleOf ;
        vg:field "stream"
    ] .

# owncast_internal/get_hardware_stats
f:row-hardware a vg:VirtualMapping ;
    vg:mapsContract f:contract ;
    vg:mapsOntologyClass :HardwareSample ;
    vg:mapsEntity "Hardware" ;
    vg:keyField "id" ;
    vg:approved "true"^^xsd:boolean ;
    vg:hasPredicateFieldPair [
        a vg:PredicateFieldPair ;
        vg:predicate :cpuUsagePercent ;
        vg:field "cpu"
    ], [
        a vg:PredicateFieldPair ;
        vg:predicate :memoryUsagePercent ;
        vg:field "ram"
    ] .

# owncast_chat/get_chat_messages
f:row-chat-message a vg:VirtualMapping ;
    vg:mapsContract f:contract ;
    vg:mapsOntologyClass :ChatMessage ;
    vg:mapsEntity "ChatMessage" ;
    vg:keyField "id" ;
    vg:approved "true"^^xsd:boolean ;
    vg:hasPredicateFieldPair [
        a vg:PredicateFieldPair ;
        vg:predicate :text ;
        vg:field "content"
    ], [
        a vg:PredicateFieldPair ;
        vg:predicate :postedAt ;
        vg:field "created_at"
    ], [
        a vg:PredicateFieldPair ;
        vg:predicate :postedBy ;
        vg:field "author"
    ] .

# owncast_internal/get_followers
f:row-follower a vg:VirtualMapping ;
    vg:mapsContract f:contract ;
    vg:mapsOntologyClass :Follower ;
    vg:mapsEntity "Follower" ;
    vg:keyField "id" ;
    vg:approved "true"^^xsd:boolean ;
    vg:hasPredicateFieldPair [
        a vg:PredicateFieldPair ;
        vg:predicate :title ;
        vg:field "username"
    ] .
