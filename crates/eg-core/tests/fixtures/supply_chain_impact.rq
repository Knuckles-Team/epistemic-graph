# Class-only impact query (MEDULLA-SUPPLY-VOCAB-R008.1), from plan.md "Worked
# example": "Which services are exposed by a vulnerable component supplied
# by a vendor we also buy hardware from?"
#
# The query names only the shared vocabulary classes and properties plus
# infra:Service -- no connector, tool or doctype name. Which source serves
# each class (dockerhub, container-manager, uptime, erpnext) is decided by
# the authority rows at serve time, never in the query text.

PREFIX kg: <http://knuckles.team/kg#>
PREFIX infra: <http://knuckles.team/kg/infrastructure#>
SELECT ?service ?supplier ?comp ?ver ?cve ?sev WHERE {
  ?service a infra:Service ; kg:usesComponent ?cv .
  ?cv kg:versionOf ?comp ; kg:versionString ?ver .
  ?comp kg:publishedBy ?supplier .
  ?vuln kg:affectsComponent ?cv ; kg:cveId ?cve ; kg:severity ?sev .
  ?supplier kg:suppliesItem ?item .
}
