PREFIX : <http://knuckles.team/kg#>
PREFIX dc: <http://purl.org/dc/terms/>
SELECT ?candidate ?kind ?source WHERE {
  :TaskXYZ :requiresCapability ?capability .
  ?candidate :memberOfLibrary ?library ; :providesCapability ?capability ;
             a ?kind ; dc:source ?source .
  FILTER (?kind IN (:AgentTemplate, :A2AAgentCard))
}
