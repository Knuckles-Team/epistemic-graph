@prefix : <http://knuckles.team/kg#> .
@prefix infra: <http://knuckles.team/kg/infrastructure#> .
@prefix vg: <http://knuckles.team/kg/virtual-graph#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix xsaa: <http://knuckles.team/xsrc/seed-authority#> .

# Seed authority rows for the cross-source competency questions
# (specs/cross-source-competency/plan.md "Concepts and sources" table). One
# vg:SourceAuthority per (source, class) pair, ranked (lower wins). The rows
# are ontology data, not engine behaviour: an operator edits them in the
# graph. Seeded by the delivery of EG-CQ-XSRC-R005.2/R005.3/R007.1/R008.1.1/
# R008.2.3/R008.3.3; the rows each question needs are noted inline.

# --- Connections ------------------------------------------------------------

xsaa:erpnext a vg:SourceConnection ; rdfs:label "erpnext-mcp" .
xsaa:leanix a vg:SourceConnection ; rdfs:label "leanix-mcp" .
xsaa:dockerhub a vg:SourceConnection ; rdfs:label "dockerhub-mcp" .
xsaa:gitlab a vg:SourceConnection ; rdfs:label "gitlab-mcp" .
xsaa:github a vg:SourceConnection ; rdfs:label "github-mcp" .
xsaa:container-manager a vg:SourceConnection ; rdfs:label "container-manager-mcp" .
xsaa:portainer a vg:SourceConnection ; rdfs:label "portainer-mcp" .
xsaa:uptime a vg:SourceConnection ; rdfs:label "uptime-mcp" .
xsaa:lgtm a vg:SourceConnection ; rdfs:label "lgtm-mcp" .
xsaa:servicenow a vg:SourceConnection ; rdfs:label "servicenow-mcp" .
xsaa:systems-manager a vg:SourceConnection ; rdfs:label "systems-manager-mcp" .
xsaa:salesforce a vg:SourceConnection ; rdfs:label "salesforce-mcp" .
xsaa:twenty a vg:SourceConnection ; rdfs:label "twenty-mcp" .
xsaa:archimate a vg:SourceConnection ; rdfs:label "archimate-mcp" .
xsaa:ciso a vg:SourceConnection ; rdfs:label "ciso-assistant-mcp" .

# --- Suppliers and purchase items (EG-CQ-XSRC-R002.5 judgement: ERPNext is the
#     transactional procurement system; LeanIX is the architecture catalogue) ---

xsaa:supplier-erpnext a vg:SourceAuthority ;
    vg:authoritativeSource xsaa:erpnext ;
    vg:authorityFor :Supplier ;
    vg:authorityRank 1 ;
    vg:allowFallback false .

xsaa:supplier-leanix a vg:SourceAuthority ;
    vg:authoritativeSource xsaa:leanix ;
    vg:authorityFor :Supplier ;
    vg:authorityRank 2 .

xsaa:supply-chain-item-erpnext a vg:SourceAuthority ;
    vg:authoritativeSource xsaa:erpnext ;
    vg:authorityFor :SupplyChainItem ;
    vg:authorityRank 1 .

xsaa:supply-chain-item-leanix a vg:SourceAuthority ;
    vg:authoritativeSource xsaa:leanix ;
    vg:authorityFor :SupplyChainItem ;
    vg:authorityRank 2 .

# --- Software components (the code host says what a component is; the
#     registry says what an image is -- EG-CQ-XSRC-R002.6 judgement) ---

xsaa:software-component-github a vg:SourceAuthority ;
    vg:authoritativeSource xsaa:github ;
    vg:authorityFor :SoftwareComponent ;
    vg:authorityRank 1 .

xsaa:software-component-dockerhub a vg:SourceAuthority ;
    vg:authoritativeSource xsaa:dockerhub ;
    vg:authorityFor :SoftwareComponent ;
    vg:authorityRank 2 .

xsaa:container-image-dockerhub a vg:SourceAuthority ;
    vg:authoritativeSource xsaa:dockerhub ;
    vg:authorityFor infra:ContainerImage ;
    vg:authorityRank 1 .

xsaa:container-image-github a vg:SourceAuthority ;
    vg:authoritativeSource xsaa:github ;
    vg:authorityFor infra:ContainerImage ;
    vg:authorityRank 2 .

# --- Vulnerabilities (the code host says what is wrong with it) ---

xsaa:vulnerability-gitlab a vg:SourceAuthority ;
    vg:authoritativeSource xsaa:gitlab ;
    vg:authorityFor :Vulnerability ;
    vg:authorityRank 1 .

xsaa:vulnerability-github a vg:SourceAuthority ;
    vg:authoritativeSource xsaa:github ;
    vg:authorityFor :Vulnerability ;
    vg:authorityRank 2 .

# --- Services (live health; the CMDB identity facet and the metrics alternate
#     are seeded by the EG-CQ-XSRC-R003.1 delivery row) ---

xsaa:service-uptime a vg:SourceAuthority ;
    vg:authoritativeSource xsaa:uptime ;
    vg:authorityFor infra:Service ;
    vg:authorityRank 1 .

# --- Deployed workloads (EG-CQ-XSRC-R003.2: orchestrator first, portainer
#     second) ---

xsaa:workload-container-manager a vg:SourceAuthority ;
    vg:authoritativeSource xsaa:container-manager ;
    vg:authorityFor infra:Workload ;
    vg:authorityRank 1 .

xsaa:workload-portainer a vg:SourceAuthority ;
    vg:authoritativeSource xsaa:portainer ;
    vg:authorityFor infra:Workload ;
    vg:authorityRank 2 .

# --- Host readings (EG-CQ-XSRC-R008.2.3: metrics rank 1, systems-manager
#     rank 2) ---

xsaa:host-lgtm a vg:SourceAuthority ;
    vg:authoritativeSource xsaa:lgtm ;
    vg:authorityFor infra:Host ;
    vg:authorityRank 1 .

xsaa:host-systems-manager a vg:SourceAuthority ;
    vg:authoritativeSource xsaa:systems-manager ;
    vg:authorityFor infra:Host ;
    vg:authorityRank 2 .

# --- Business capabilities (LeanIX is the maintained catalogue, ArchiMate the
#     modelled view) ---

xsaa:business-capability-leanix a vg:SourceAuthority ;
    vg:authoritativeSource xsaa:leanix ;
    vg:authorityFor :BusinessCapability ;
    vg:authorityRank 1 .

xsaa:business-capability-archimate a vg:SourceAuthority ;
    vg:authoritativeSource xsaa:archimate ;
    vg:authorityFor :BusinessCapability ;
    vg:authorityRank 2 .

# --- Incidents and changes (EG-CQ-XSRC-R008.3.3: servicenow rank 1; erpnext
#     rank 2, which serves :ErpNextIssue, the owl:equivalentClass of
#     :Incident) ---

xsaa:incident-servicenow a vg:SourceAuthority ;
    vg:authoritativeSource xsaa:servicenow ;
    vg:authorityFor :Incident ;
    vg:authorityRank 1 .

xsaa:incident-erpnext a vg:SourceAuthority ;
    vg:authoritativeSource xsaa:erpnext ;
    vg:authorityFor :Incident ;
    vg:authorityRank 2 .

xsaa:change-servicenow a vg:SourceAuthority ;
    vg:authoritativeSource xsaa:servicenow ;
    vg:authorityFor :Change ;
    vg:authorityRank 1 .

xsaa:erpnext-issue-erpnext a vg:SourceAuthority ;
    vg:authoritativeSource xsaa:erpnext ;
    vg:authorityFor :ErpNextIssue ;
    vg:authorityRank 2 .

# --- Customer contracts (salesforce rank 1, twenty rank 2) ---

xsaa:customer-contract-salesforce a vg:SourceAuthority ;
    vg:authoritativeSource xsaa:salesforce ;
    vg:authorityFor :CustomerContract ;
    vg:authorityRank 1 .

xsaa:customer-contract-twenty a vg:SourceAuthority ;
    vg:authoritativeSource xsaa:twenty ;
    vg:authorityFor :CustomerContract ;
    vg:authorityRank 2 .

# --- Third-party risk (EG-CQ-XSRC-R002.5: the GRC register is authoritative) ---

xsaa:technology-risk-ciso a vg:SourceAuthority ;
    vg:authoritativeSource xsaa:ciso ;
    vg:authorityFor :TechnologyRisk ;
    vg:authorityRank 1 .

# --- Facet rows (EG-CQ-XSRC-R003.1, R003.2): where two sources hold different
#     facets of one class, the row names the facet instead of the whole class.
#     A class-level question is unaffected; a facet question reads these. ---

xsaa:service-health-uptime a vg:SourceAuthority ;
    vg:authoritativeSource xsaa:uptime ;
    vg:authorityFor infra:Service ;
    vg:authorityFacet :healthStatus ;
    vg:authorityRank 1 .

xsaa:service-health-lgtm a vg:SourceAuthority ;
    vg:authoritativeSource xsaa:lgtm ;
    vg:authorityFor infra:Service ;
    vg:authorityFacet :healthStatus ;
    vg:authorityRank 2 .

xsaa:service-identity-servicenow a vg:SourceAuthority ;
    vg:authoritativeSource xsaa:servicenow ;
    vg:authorityFor infra:Service ;
    vg:authorityFacet dc:identifier ;
    vg:authorityRank 1 .

xsaa:image-deployment-container-manager a vg:SourceAuthority ;
    vg:authoritativeSource xsaa:container-manager ;
    vg:authorityFor infra:ContainerImage ;
    vg:authorityFacet infra:deployedAs ;
    vg:authorityRank 1 .

xsaa:image-deployment-portainer a vg:SourceAuthority ;
    vg:authoritativeSource xsaa:portainer ;
    vg:authorityFor infra:ContainerImage ;
    vg:authorityFacet infra:deployedAs ;
    vg:authorityRank 2 .

xsaa:host-placement-container-manager a vg:SourceAuthority ;
    vg:authoritativeSource xsaa:container-manager ;
    vg:authorityFor infra:Host ;
    vg:authorityFacet infra:hostedBy ;
    vg:authorityRank 1 .

xsaa:host-placement-portainer a vg:SourceAuthority ;
    vg:authoritativeSource xsaa:portainer ;
    vg:authorityFor infra:Host ;
    vg:authorityFacet infra:hostedBy ;
    vg:authorityRank 2 .

xsaa:host-hardware-systems-manager a vg:SourceAuthority ;
    vg:authoritativeSource xsaa:systems-manager ;
    vg:authorityFor infra:Host ;
    vg:authorityFacet :hardwareFacts ;
    vg:authorityRank 1 .
