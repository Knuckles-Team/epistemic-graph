@prefix : <http://knuckles.team/kg#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Government ABox shapes (EG-CQ-CONN-R073.x): a privacy assessment must carry
# its refresh due date, so an onetrust record without one is incomplete.

:PrivacyAssessmentShape a sh:NodeShape ;
    sh:description "A privacy assessment names its refresh due date." ;
    sh:name "Privacy Assessment Shape" ;
    sh:property [ sh:datatype xsd:date ;
            sh:message "A privacy assessment must have at least one assessmentDueDate." ;
            sh:minCount 1 ;
            sh:path :assessmentDueDate ] ;
    sh:targetClass :PrivacyAssessment .
