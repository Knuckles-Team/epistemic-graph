@prefix : <http://knuckles.team/kg#> .
@prefix bfo: <http://purl.obolibrary.org/obo/BFO_> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix dwc: <http://rs.tdwg.org/dwc/terms/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# World-model base ontology (operator ruling 2026-09-22, night).
#
# A THIN native TBox: only the classes and relations EG reasons over, placed under
# the core BFO layer, with skos mappings to the canonical external ontologies
# (RO, BFO, COB, NCBITaxon/Darwin Core/TAXRANK, GO, ENVO, ChEBI, FoodOn, PATO, UBERON,
# OGMS, SOSA, Wikidata). Mappings are annotations only: nothing is imported.
#
# Large vocabularies are DATA. A taxon, a GO term, an ENVO or UBERON term, a ChEBI
# entity or a FoodOn food is ingested as an INDIVIDUAL of a :ReferenceTerm class
# (never one OWL class per species or per term), and particulars point at the kind
# they instantiate with :instanceOfTerm / :inTaxon. Reasoning stays bounded by the
# size of this document, not by the size of the external vocabularies (EH-355).

<http://knuckles.team/kg/world_model> a owl:Ontology ;
    rdfs:label "World-Model Base Ontology" ;
    rdfs:comment "Organisms and taxa, biological processes, anatomy hooks, environments and habitats, weather and climate systems, chemical entities, foods, nutrients and nutritional requirements — BFO-placed, mapped to the OBO Foundry ontologies and Wikidata, with large vocabularies ingested as individuals." ;
    owl:imports <http://knuckles.team/kg/core> .

# ── Reference terms: external vocabulary entries as individuals ─────────────────

:ReferenceTerm a owl:Class ;
    rdfs:label "Reference Term" ;
    rdfs:comment "An entry of an external reference vocabulary — a taxonomy, an OBO ontology, a food or chemical database — ingested as an individual. It stands for a KIND (the external class it names), so particulars link to it with :instanceOfTerm. BFO:GenericallyDependentContinuant." ;
    rdfs:subClassOf bfo:0000031,
        skos:Concept .

:instanceOfTerm a owl:ObjectProperty ;
    rdfs:label "instance of term" ;
    rdfs:comment "A particular is an instance of the kind a reference term names (this organism of that species, this habitat of that ENVO type, this process of that GO type)." ;
    rdfs:subPropertyOf :classifiedAs ;
    rdfs:range :ReferenceTerm .

:termCurie a owl:DatatypeProperty ;
    rdfs:label "term CURIE" ;
    rdfs:comment "The compact identifier of a reference term in its source vocabulary, e.g. NCBITaxon:9606, GO:0015979, ENVO:01000174, CHEBI:29073, FOODON:03301710, PATO:0000146, UBERON:0000948." ;
    rdfs:domain :ReferenceTerm ;
    rdfs:range xsd:string .

:wikidataId a owl:DatatypeProperty ;
    rdfs:label "Wikidata id" ;
    rdfs:comment "The Wikidata item id (Q-number) of the named thing this node describes; the entity-resolution key for named places, taxa, foods and chemicals." ;
    rdfs:range xsd:string .

:quantityValue a owl:DatatypeProperty ;
    rdfs:label "quantity value" ;
    rdfs:comment "The numeric magnitude of a measured or reference quantity; its unit is :unitCode." ;
    rdfs:range xsd:decimal .

:unitCode a owl:DatatypeProperty ;
    rdfs:label "unit code" ;
    rdfs:comment "The UCUM code of the unit a :quantityValue is expressed in (e.g. mg, ug, kcal, Cel, mm/h)." ;
    rdfs:range xsd:string .

# ── Life: organisms and taxonomy ───────────────────────────────────────────────

:Organism a owl:Class ;
    rdfs:label "Organism" ;
    rdfs:comment "A living individual — an animal, plant, fungus, microbe — or a formerly living one. BFO:Object." ;
    rdfs:subClassOf bfo:0000030 ;
    skos:exactMatch obo:COB_0000022,
        wd:Q7239 .

:Person rdfs:subClassOf :Organism .

:Taxon a owl:Class ;
    rdfs:label "Taxon" ;
    rdfs:comment "A taxonomic unit (a species, a genus, a family …) as circumscribed by a taxonomy such as NCBI Taxonomy or the GBIF backbone. Taxa are INDIVIDUALS of this class, linked by :parentTaxon and ranked by :taxonRank — never one OWL class per species. BFO:GenericallyDependentContinuant." ;
    rdfs:subClassOf :ReferenceTerm ;
    skos:exactMatch dwc:Taxon,
        wd:Q16521 .

:TaxonRank a owl:Class ;
    rdfs:label "Taxon Rank" ;
    rdfs:comment "A level of a taxonomic hierarchy (species, genus, family …). The principal ranks are declared below as individuals; other ranks are ingested the same way. BFO:GenericallyDependentContinuant." ;
    rdfs:subClassOf bfo:0000031 ;
    skos:exactMatch obo:TAXRANK_0000000,
        wd:Q427626 .

:inTaxon a owl:ObjectProperty ;
    rdfs:label "in taxon" ;
    rdfs:comment "A material entity (an organism, an anatomical entity, a food portion from an organism) is of the given taxon (RO in taxon)." ;
    rdfs:subPropertyOf :instanceOfTerm ;
    rdfs:domain bfo:0000040 ;
    rdfs:range :Taxon ;
    skos:exactMatch obo:RO_0002162 .

:parentTaxon a owl:ObjectProperty ;
    rdfs:label "parent taxon" ;
    rdfs:comment "The immediately enclosing taxon in the source taxonomy. Deliberately NOT transitive: a full taxonomy has millions of taxa, and ancestry is a query-time path, not a materialized closure." ;
    rdfs:domain :Taxon ;
    rdfs:range :Taxon ;
    skos:closeMatch dwc:parentNameUsageID .

:taxonRank a owl:ObjectProperty ;
    rdfs:label "taxon rank" ;
    rdfs:domain :Taxon ;
    rdfs:range :TaxonRank ;
    skos:closeMatch dwc:taxonRank .

:scientificName a owl:DatatypeProperty ;
    rdfs:label "scientific name" ;
    rdfs:comment "The full scientific name of a taxon, e.g. Vulpes vulpes." ;
    rdfs:domain :Taxon ;
    rdfs:range xsd:string ;
    skos:exactMatch dwc:scientificName .

:ncbiTaxonId a owl:DatatypeProperty ;
    rdfs:label "NCBI Taxonomy id" ;
    rdfs:comment "The NCBI Taxonomy identifier (the NCBITaxon_<id> OBO class)." ;
    rdfs:domain :Taxon ;
    rdfs:range xsd:string .

:gbifTaxonKey a owl:DatatypeProperty ;
    rdfs:label "GBIF taxon key" ;
    rdfs:comment "The GBIF backbone taxonomy usage key." ;
    rdfs:domain :Taxon ;
    rdfs:range xsd:string .

:rank-domain a :TaxonRank ;
    rdfs:label "domain" ;
    skos:exactMatch wd:Q146481 .

:rank-kingdom a :TaxonRank ;
    rdfs:label "kingdom" ;
    skos:exactMatch obo:TAXRANK_0000017,
        wd:Q36732 .

:rank-phylum a :TaxonRank ;
    rdfs:label "phylum" ;
    skos:exactMatch obo:TAXRANK_0000001,
        wd:Q38348 .

:rank-class a :TaxonRank ;
    rdfs:label "class" ;
    skos:exactMatch obo:TAXRANK_0000002,
        wd:Q37517 .

:rank-order a :TaxonRank ;
    rdfs:label "order" ;
    skos:exactMatch obo:TAXRANK_0000003,
        wd:Q36602 .

:rank-family a :TaxonRank ;
    rdfs:label "family" ;
    skos:exactMatch obo:TAXRANK_0000004,
        wd:Q35409 .

:rank-genus a :TaxonRank ;
    rdfs:label "genus" ;
    skos:exactMatch obo:TAXRANK_0000005,
        wd:Q34740 .

:rank-species a :TaxonRank ;
    rdfs:label "species" ;
    skos:exactMatch obo:TAXRANK_0000006,
        wd:Q7432 .

:rank-subspecies a :TaxonRank ;
    rdfs:label "subspecies" ;
    skos:exactMatch obo:TAXRANK_0000023,
        wd:Q68947 .

# ── Life: biological processes and anatomy hooks ───────────────────────────────

:BiologicalProcess a owl:Class ;
    rdfs:label "Biological Process" ;
    rdfs:comment "A process carried out by one or more organisms or their parts — photosynthesis in a leaf, digestion in a gut, a migration. Its kind is a GO biological-process term (:instanceOfTerm a :BiologicalProcessTerm). BFO:Process." ;
    rdfs:subClassOf bfo:0000015 ;
    skos:exactMatch obo:GO_0008150,
        wd:Q2996394 .

:PathologicalProcess a owl:Class ;
    rdfs:label "Pathological Process" ;
    rdfs:comment "A biological process that realizes a disease or clinical condition (the course of an infection, tumour growth). BFO:Process." ;
    rdfs:subClassOf :BiologicalProcess ;
    skos:exactMatch obo:OGMS_0000061 .

:BiologicalProcessTerm a owl:Class ;
    rdfs:label "Biological Process Term" ;
    rdfs:comment "A Gene Ontology biological-process term ingested as an individual; it names a kind of :BiologicalProcess." ;
    rdfs:subClassOf :ReferenceTerm ;
    skos:relatedMatch obo:GO_0008150 .

:AnatomicalEntity a owl:Class ;
    rdfs:label "Anatomical Entity" ;
    rdfs:comment "A part of an organism's body — an organ, a tissue, a cell (hook for UBERON/CL). Related to its organism with core :partOf; its kind is an :AnatomyTerm. BFO:MaterialEntity." ;
    rdfs:subClassOf bfo:0000040 ;
    skos:closeMatch obo:UBERON_0001062,
        wd:Q4936952 .

:AnatomyTerm a owl:Class ;
    rdfs:label "Anatomy Term" ;
    rdfs:comment "An UBERON (or CL) anatomy term ingested as an individual; it names a kind of :AnatomicalEntity." ;
    rdfs:subClassOf :ReferenceTerm ;
    skos:relatedMatch obo:UBERON_0001062 .

:taxonCapableOf a owl:ObjectProperty ;
    rdfs:label "taxon capable of" ;
    rdfs:comment "Organisms of a taxon can carry out processes of a GO kind (RO capable of, lifted to the taxon: the GO-annotation aggregate for a species)." ;
    rdfs:domain :Taxon ;
    rdfs:range :BiologicalProcessTerm ;
    skos:closeMatch obo:RO_0002215 .

# ── Environment: environmental systems, habitats, weather and climate ──────────

:EnvironmentalSystem a owl:Class ;
    rdfs:label "Environmental System" ;
    rdfs:comment "A system of material entities and their surroundings that can serve as the environment of organisms or processes — a forest, a lake, a soil, the atmosphere over a region. It also serves as a :Place (things are :locatedIn it). BFO:MaterialEntity." ;
    rdfs:subClassOf bfo:0000040,
        :Place ;
    skos:exactMatch obo:ENVO_01000254 .

:Habitat a owl:Class ;
    rdfs:label "Habitat" ;
    rdfs:comment "An environmental system that sustains a population of organisms. Its kind is an ENVO term (:instanceOfTerm a :EnvironmentTerm)." ;
    rdfs:subClassOf :EnvironmentalSystem ;
    skos:exactMatch obo:ENVO_01000739,
        wd:Q52105 .

:Ecosystem a owl:Class ;
    rdfs:label "Ecosystem" ;
    rdfs:comment "An environmental system together with the community of organisms living in it." ;
    rdfs:subClassOf :EnvironmentalSystem ;
    skos:exactMatch obo:ENVO_01001110,
        wd:Q37813 .

:ClimateSystem a owl:Class ;
    rdfs:label "Climate System" ;
    rdfs:comment "The Earth system that determines climate — atmosphere, hydrosphere, cryosphere, land surface and biosphere — or a regional part of it. Weather systems are :partOf it." ;
    rdfs:subClassOf :EnvironmentalSystem ;
    skos:broadMatch obo:ENVO_01000254 ;
    skos:relatedMatch wd:Q7937 .

:WeatherSystem a owl:Class ;
    rdfs:label "Weather System" ;
    rdfs:comment "An organized atmospheric system — a cyclone, an anticyclone, a front, a convective storm complex — within which weather events occur." ;
    rdfs:subClassOf :EnvironmentalSystem ;
    skos:broadMatch obo:ENVO_01000254 ;
    skos:relatedMatch wd:Q11663 .

:EnvironmentTerm a owl:Class ;
    rdfs:label "Environment Term" ;
    rdfs:comment "An ENVO term (biome, habitat, environmental material, climate type) ingested as an individual; it names a kind of :EnvironmentalSystem or environmental feature." ;
    rdfs:subClassOf :ReferenceTerm ;
    skos:relatedMatch obo:ENVO_01000254 .

:hasHabitat a owl:ObjectProperty ;
    rdfs:label "has habitat" ;
    rdfs:comment "An organism lives in a habitat, and so is located in it (RO has habitat). Organism-level; a taxon's typical habitat kind is :taxonHabitat." ;
    rdfs:subPropertyOf :locatedIn ;
    rdfs:domain :Organism ;
    rdfs:range :Habitat ;
    owl:inverseOf :habitatOf ;
    skos:exactMatch obo:RO_0002303 .

:habitatOf a owl:ObjectProperty ;
    rdfs:label "habitat of" ;
    rdfs:comment "A habitat sustains an organism. Inverse of hasHabitat." ;
    rdfs:subPropertyOf :contains .

:taxonHabitat a owl:ObjectProperty ;
    rdfs:label "taxon habitat" ;
    rdfs:comment "Organisms of a taxon typically live in environments of an ENVO kind (the taxon-level habitat association)." ;
    rdfs:domain :Taxon ;
    rdfs:range :EnvironmentTerm ;
    skos:closeMatch obo:RO_0002303 .

# ── Chemistry, food and nutrition ──────────────────────────────────────────────

:ChemicalEntityTerm a owl:Class ;
    rdfs:label "Chemical Entity Term" ;
    rdfs:comment "A ChEBI entry (a molecular entity, a group, or a chemical class such as vitamin C) ingested as an individual; it names a kind of chemical entity." ;
    rdfs:subClassOf :ReferenceTerm ;
    skos:relatedMatch obo:CHEBI_24431,
        wd:Q79529 .

:Nutrient a owl:Class ;
    rdfs:label "Nutrient" ;
    rdfs:comment "A chemical-entity term whose instances play a nutrient role for some organism (energy, structure, or regulation of metabolism). The nutrient ↔ ChEBI link is this subclassing plus :termCurie." ;
    rdfs:subClassOf :ChemicalEntityTerm ;
    skos:relatedMatch obo:CHEBI_33284,
        wd:Q181394 .

:Food a owl:Class ;
    rdfs:label "Food" ;
    rdfs:comment "A portion of material that an organism eats or drinks for nutrition. Its kind is a :FoodTerm (FoodOn or a food-composition database entry). BFO:MaterialEntity." ;
    rdfs:subClassOf bfo:0000040 ;
    skos:closeMatch obo:FOODON_00002403,
        wd:Q2095 .

:FoodTerm a owl:Class ;
    rdfs:label "Food Term" ;
    rdfs:comment "A FoodOn food product type or a food-composition database food (USDA FoodData Central, national tables) ingested as an individual; it names a kind of :Food." ;
    rdfs:subClassOf :ReferenceTerm ;
    skos:relatedMatch obo:FOODON_00002403 .

:consumes a owl:ObjectProperty ;
    rdfs:label "consumes" ;
    rdfs:comment "An organism eats or drinks a material entity — a food portion, another organism (RO eats)." ;
    rdfs:domain :Organism ;
    rdfs:range bfo:0000040 ;
    skos:closeMatch obo:RO_0002470 .

:taxonEats a owl:ObjectProperty ;
    rdfs:label "taxon eats" ;
    rdfs:comment "Organisms of a taxon eat things of a kind — a food term or a prey taxon (taxon-level diet interaction, as published by GloBI)." ;
    rdfs:domain :Taxon ;
    rdfs:range :ReferenceTerm ;
    skos:closeMatch obo:RO_0002470 .

:NutritionalRequirement a owl:Class ;
    rdfs:label "Nutritional Requirement" ;
    rdfs:comment "An organism's need for a nutrient: a BFO disposition borne by the organism, realized in its metabolic processes. Not a document — a published recommended intake is a separate :NutrientReferenceIntake." ;
    rdfs:subClassOf bfo:0000016,
        [ a owl:Restriction ;
            owl:onProperty :inheresIn ;
            owl:someValuesFrom :Organism ] ;
    skos:relatedMatch obo:CHEBI_33284 .

:nutritionalRequirementOf a owl:ObjectProperty ;
    rdfs:label "nutritional requirement of" ;
    rdfs:comment "The world-model meaning of the shared :inheresIn: the organism that bears a nutritional requirement." ;
    rdfs:subPropertyOf :inheresIn ;
    rdfs:domain :NutritionalRequirement ;
    rdfs:range :Organism .

:requirementForNutrient a owl:ObjectProperty ;
    rdfs:label "requirement for nutrient" ;
    rdfs:comment "The nutrient a nutritional requirement is a requirement for." ;
    rdfs:domain :NutritionalRequirement ;
    rdfs:range :Nutrient .

:requiresNutrient a owl:ObjectProperty ;
    rdfs:label "requires nutrient" ;
    rdfs:comment "An organism requires a nutrient: derived from the requirement it bears (bearerOf ∘ requirementForNutrient), or asserted directly." ;
    rdfs:domain :Organism ;
    rdfs:range :Nutrient ;
    owl:propertyChainAxiom ( :bearerOf :requirementForNutrient ) .

:NutrientReferenceIntake a owl:Class ;
    rdfs:label "Nutrient Reference Intake" ;
    rdfs:comment "A published reference value for a taxon's intake of one nutrient — an RDA, AI, EAR or UL from a dietary reference intake table, or an animal nutrient requirement — optionally per life stage. It is the species-level information ABOUT nutritional requirements. BFO:GenericallyDependentContinuant." ;
    rdfs:subClassOf bfo:0000031 ;
    skos:relatedMatch wd:Q181394 .

:referenceTaxon a owl:ObjectProperty ;
    rdfs:label "reference taxon" ;
    rdfs:domain :NutrientReferenceIntake ;
    rdfs:range :Taxon .

:referenceNutrient a owl:ObjectProperty ;
    rdfs:label "reference nutrient" ;
    rdfs:domain :NutrientReferenceIntake ;
    rdfs:range :Nutrient .

:lifeStage a owl:DatatypeProperty ;
    rdfs:label "life stage" ;
    rdfs:comment "The life stage / population group a reference intake applies to (e.g. adult female 19-30 y, lactation, puppy)." ;
    rdfs:domain :NutrientReferenceIntake ;
    rdfs:range xsd:string .

:FoodCompositionRecord a owl:Class ;
    rdfs:label "Food Composition Record" ;
    rdfs:comment "A food-composition database entry (e.g. a USDA FoodData Central food) giving the nutrient content of one food kind. BFO:GenericallyDependentContinuant." ;
    rdfs:subClassOf bfo:0000031 ;
    skos:relatedMatch obo:FOODON_00002403 .

:describesFood a owl:ObjectProperty ;
    rdfs:label "describes food" ;
    rdfs:domain :FoodCompositionRecord ;
    rdfs:range :FoodTerm .

:hasNutrientAmount a owl:ObjectProperty ;
    rdfs:label "has nutrient amount" ;
    rdfs:domain :FoodCompositionRecord ;
    rdfs:range :NutrientAmount .

:NutrientAmount a owl:Class ;
    rdfs:label "Nutrient Amount" ;
    rdfs:comment "The amount of one nutrient per reference quantity of a food (:quantityValue, :unitCode, per 100 g unless stated). BFO:GenericallyDependentContinuant." ;
    rdfs:subClassOf bfo:0000031 ;
    skos:relatedMatch obo:CHEBI_33284 .

:amountOfNutrient a owl:ObjectProperty ;
    rdfs:label "amount of nutrient" ;
    rdfs:domain :NutrientAmount ;
    rdfs:range :Nutrient .

:fdcId a owl:DatatypeProperty ;
    rdfs:label "FoodData Central id" ;
    rdfs:domain :FoodCompositionRecord ;
    rdfs:range xsd:string .

# ── Observations of organisms and weather ──────────────────────────────────────

:QualityTerm a owl:Class ;
    rdfs:label "Quality Term" ;
    rdfs:comment "A PATO quality (or an observed-property vocabulary entry such as a CF standard name) ingested as an individual — the property an observation measures, e.g. PATO:0000146 temperature." ;
    rdfs:subClassOf :ReferenceTerm ;
    skos:relatedMatch obo:PATO_0000001 .

:OrganismObservation a owl:Class ;
    rdfs:label "Organism Observation" ;
    rdfs:comment "An occurrence record: an organism of an identified taxon observed at a place and time (a GBIF / iNaturalist occurrence)." ;
    rdfs:subClassOf :Observation ;
    skos:closeMatch dwc:Occurrence ;
    skos:broadMatch sosa:Observation .

:WeatherObservation a owl:Class ;
    rdfs:label "Weather Observation" ;
    rdfs:comment "A measurement of an atmospheric quality (temperature, precipitation, wind speed …) at a place and time, from a station, a reanalysis or a forecast model." ;
    rdfs:subClassOf :Observation ;
    skos:broadMatch sosa:Observation .

:observedEntity a owl:ObjectProperty ;
    rdfs:label "observed entity" ;
    rdfs:comment "The entity an observation is about — the feature of interest (sosa:hasFeatureOfInterest)." ;
    rdfs:domain :Observation ;
    skos:closeMatch sosa:hasFeatureOfInterest .

:observedOrganism a owl:ObjectProperty ;
    rdfs:label "observed organism" ;
    rdfs:subPropertyOf :observedEntity ;
    rdfs:domain :OrganismObservation ;
    rdfs:range :Organism .

:observedTaxon a owl:ObjectProperty ;
    rdfs:label "observed taxon" ;
    rdfs:comment "The taxon the observed organism was identified as." ;
    rdfs:domain :OrganismObservation ;
    rdfs:range :Taxon .

:observedQuality a owl:ObjectProperty ;
    rdfs:label "observed quality" ;
    rdfs:comment "The quality an observation measures (sosa:observedProperty)." ;
    rdfs:domain :Observation ;
    rdfs:range :QualityTerm ;
    skos:closeMatch sosa:observedProperty .

:observationTime a owl:DatatypeProperty ;
    rdfs:label "observation time" ;
    rdfs:comment "When the observed phenomenon happened (sosa:phenomenonTime)." ;
    rdfs:domain :Observation ;
    rdfs:range xsd:dateTime .

# ── Wiring into the existing modules ───────────────────────────────────────────

# energy_geopolitics: regions and countries are places, so organisms, habitats and
# weather events are located in / occur in them.
:Region rdfs:subClassOf :Place ;
    skos:closeMatch wd:Q82794 .

:Country rdfs:subClassOf :Place ;
    skos:exactMatch wd:Q6256 .

# energy_geopolitics: a weather event is a process within a weather system.
:WeatherEvent rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty :occursIn ;
        owl:someValuesFrom :WeatherSystem ] .

# medical: a clinical condition is borne by an organism (a patient is a person,
# a person is an organism) and is realized in pathological processes (:hasRealization).
:ClinicalCondition rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty :inheresIn ;
        owl:someValuesFrom :Organism ] .
