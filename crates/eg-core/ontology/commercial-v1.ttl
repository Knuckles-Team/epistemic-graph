@prefix : <http://knuckles.team/kg#> .
@prefix infra: <http://knuckles.team/kg/infrastructure#> .
@prefix bfo: <http://purl.obolibrary.org/obo/BFO_> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://knuckles.team/kg/commercial> a owl:Ontology ;
    rdfs:label "Commercial" ;
    rdfs:comment "Customer, contract and opportunity vocabulary: the commercial side of the supply chain. Reuses the ERPNext IRIs in the shared kg namespace; source mappings supply the relationships." ;
    owl:imports <http://knuckles.team/kg/core> .

:Customer a owl:Class ;
    rdfs:label "Customer" ;
    rdfs:comment "An organization or person that buys: the same IRI as the ERPNext Customer doctype. Salesforce Account and Twenty Company records resolve to it." ;
    rdfs:subClassOf :Organization, :BusinessActor .

:CustomerContract a owl:Class ;
    rdfs:label "Customer Contract" ;
    rdfs:comment """A commercial contract a customer holds. It names its customer and covers
at least one service; the contract-to-service link is source-mapped, and until a
source names it the report abstains Uncovered.""" ;
    rdfs:subClassOf bfo:0000031 .

:coversService a owl:ObjectProperty ;
    rdfs:label "covers service" ;
    rdfs:comment "Links a CustomerContract to each Service the contract covers." ;
    rdfs:domain :CustomerContract ;
    rdfs:range infra:Service .

:contractCustomer a owl:ObjectProperty ;
    rdfs:label "contract customer" ;
    rdfs:comment "Links a CustomerContract to the one Customer that holds it." ;
    rdfs:domain :CustomerContract ;
    rdfs:range :Customer .

:contractStatus a owl:DatatypeProperty ;
    rdfs:label "contract status" ;
    rdfs:comment "The status of a CustomerContract (for example active, expired or terminated); active contracts are the default filter." ;
    rdfs:domain :CustomerContract ;
    rdfs:range xsd:string .

:contractEnd a owl:DatatypeProperty ;
    rdfs:label "contract end" ;
    rdfs:comment "The date a CustomerContract ends or has ended." ;
    rdfs:domain :CustomerContract ;
    rdfs:range xsd:date .

:affectsService a owl:ObjectProperty ;
    rdfs:label "affects service" ;
    rdfs:comment """Links an Incident or Change to each Service it affects, mapped
from a ServiceNow change request and its CI relation. Reuses the shared
:Incident and :Change classes; the distinct infra:Incident keeps
infra:affectsEntity, and no commercial :ChangeRequest class is added.""" ;
    rdfs:domain [ a owl:Class ;
        owl:unionOf ( :Incident :Change ) ] ;
    rdfs:range infra:Service .

:PurchaseOrder a owl:Class ;
    rdfs:label "Purchase Order" ;
    rdfs:comment """A procurement order a supplier fulfils. Its item lines are
expressed with the shared suppliesItem relation (supplier to item), derived
from the order's supplier and its line items without redeclaring
:suppliedBy.""" ;
    rdfs:subClassOf bfo:0000031 .

:PurchaseInvoice a owl:Class ;
    rdfs:label "Purchase Invoice" ;
    rdfs:comment "An invoice a supplier issues against a purchase order." ;
    rdfs:subClassOf bfo:0000031 .

:invoiceSupplier a owl:ObjectProperty ;
    rdfs:label "invoice supplier" ;
    rdfs:comment "Links a PurchaseInvoice to the Supplier that issued it." ;
    rdfs:domain :PurchaseInvoice ;
    rdfs:range :Supplier .

:contactOf a owl:ObjectProperty ;
    rdfs:label "contact of" ;
    rdfs:comment """Links a Person to the Customer the person contacts for.
Reuses the shared :Person class for the contact representation; no :Contact
class is added.""" ;
    rdfs:domain :Person ;
    rdfs:range :Customer .

:supportsCapability a owl:ObjectProperty ;
    rdfs:label "supports capability" ;
    rdfs:comment """Links a Service to the BusinessCapability it supports.
Deliberately distinct from the shared evidence-to-claim :supports; the
LeanIX supports relation, an ArchiMate realization or serving and a CMDB
business-service relation are mapped onto it (Decision D1).""" ;
    rdfs:domain infra:Service ;
    rdfs:range :BusinessCapability .

:Opportunity a owl:Class ;
    rdfs:label "Opportunity" ;
    rdfs:comment "An open commercial opportunity with one customer and an expected close date." ;
    rdfs:subClassOf bfo:0000031 .

:opportunityCustomer a owl:ObjectProperty ;
    rdfs:label "opportunity customer" ;
    rdfs:comment "Links an Opportunity to the Customer it is with." ;
    rdfs:domain :Opportunity ;
    rdfs:range :Customer .

:closeDate a owl:DatatypeProperty ;
    rdfs:label "close date" ;
    rdfs:comment "The date an Opportunity is expected to close, or has closed." ;
    rdfs:domain :Opportunity ;
    rdfs:range xsd:dateTime .
