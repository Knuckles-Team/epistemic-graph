@prefix : <http://knuckles.team/kg#> .
@prefix bfo: <http://purl.obolibrary.org/obo/BFO_> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://knuckles.team/kg/media> a owl:Ontology ;
    rdfs:label "Media and Content Ontology" ;
    rdfs:comment "Media and content concepts aligned to schema.org media types (MediaObject, VideoObject, AudioObject, ImageObject, Book, Audiobook, MusicAlbum, TVSeries, TVSeason, Episode, Playlist, BroadcastChannel, BroadcastEvent), the W3C Ontology for Media Resources and EBUCore, IFLA LRM for work and collection structure, and ActivityStreams 2.0 for audience. Reuses CreativeWork, Collection, Rendition, Category, Policy and WorkItem from the core (EG-TYPED-PACKS-R105.8)." ;
    dcterms:source "schema.org media types; W3C Ontology for Media Resources; EBUCore; IFLA LRM; W3C ActivityStreams 2.0" ;
    owl:imports <http://knuckles.team/kg/core>, <http://knuckles.team/kg/service_operations> .

:MediaItem a owl:Class ;
    rdfs:label "Media Item" ;
    rdfs:comment "A media object: a video, audio track, image or book that a library holds (schema.org MediaObject)." ;
    skos:altLabel "Media Resource", "Media Asset", "Media Object" ;
    rdfs:subClassOf :CreativeWork .

:Video a owl:Class ;
    rdfs:label "Video" ;
    rdfs:comment "A video work: a film, clip or recorded programme (schema.org VideoObject)." ;
    skos:altLabel "Movie", "Film", "Video Clip" ;
    rdfs:subClassOf :MediaItem .

:AudioTrack a owl:Class ;
    rdfs:label "Audio Track" ;
    rdfs:comment "A single audio recording: a song, a spoken-word track (schema.org AudioObject)." ;
    skos:altLabel "Track", "Song", "Music Track" ;
    rdfs:subClassOf :MediaItem .

:Photo a owl:Class ;
    rdfs:label "Photo" ;
    rdfs:comment "A still image or photograph (schema.org ImageObject)." ;
    skos:altLabel "Image", "Picture" ;
    rdfs:subClassOf :MediaItem .

:Book a owl:Class ;
    rdfs:label "Book" ;
    rdfs:comment "A written work (schema.org Book)." ;
    skos:altLabel "E-book", "Ebook" ;
    rdfs:subClassOf :CreativeWork .

:Audiobook a owl:Class ;
    rdfs:label "Audiobook" ;
    rdfs:comment "A book published as spoken audio (schema.org Audiobook)." ;
    skos:altLabel "Audio Book" ;
    rdfs:subClassOf :Book, :MediaItem .

:MediaCollection a owl:Class ;
    rdfs:label "Media Collection" ;
    rdfs:comment "An ordered or unordered grouping of media items (IFLA LRM aggregate)." ;
    skos:altLabel "Media Group" ;
    rdfs:subClassOf :Collection .

:Album a owl:Class ;
    rdfs:label "Album" ;
    rdfs:comment "A collection of tracks or photos released or curated together (schema.org MusicAlbum)." ;
    skos:altLabel "Music Album", "Photo Album" ;
    rdfs:subClassOf :MediaCollection .

:Series a owl:Class ;
    rdfs:label "Series" ;
    rdfs:comment "A series of episodes or books (schema.org TVSeries, CreativeWorkSeries)." ;
    skos:altLabel "TV Series", "Show" ;
    rdfs:subClassOf :MediaCollection .

:Podcast a owl:Class ;
    rdfs:label "Podcast" ;
    rdfs:comment "A series of audio episodes published on a feed (schema.org PodcastSeries)." ;
    skos:altLabel "Podcast Series" ;
    rdfs:subClassOf :Series .

:Season a owl:Class ;
    rdfs:label "Season" ;
    rdfs:comment "A season of a series (schema.org TVSeason)." ;
    skos:altLabel "Series Season", "TV Season" ;
    rdfs:subClassOf :MediaCollection .

:MediaEpisode a owl:Class ;
    rdfs:label "Media Episode" ;
    rdfs:comment "One episode of a series or season (schema.org Episode)." ;
    skos:altLabel "TV Episode", "Series Episode", "Podcast Episode" ;
    rdfs:subClassOf :MediaItem .

:Playlist a owl:Class ;
    rdfs:label "Playlist" ;
    rdfs:comment "An ordered list of media items to play in sequence." ;
    skos:altLabel "Play List" ;
    rdfs:subClassOf :MediaCollection .

:MediaLibrary a owl:Class ;
    rdfs:label "Media Library" ;
    rdfs:comment "A managed store of media that a media server indexes." ;
    skos:altLabel "Library", "Photo Library" ;
    rdfs:subClassOf :MediaCollection .

:AssetStack a owl:Class ;
    rdfs:label "Asset Stack" ;
    rdfs:comment "A group of renditions or captures of the same moment." ;
    skos:altLabel "Photo Stack", "Rendition Group" ;
    rdfs:subClassOf :Collection .

:Genre a owl:Class ;
    rdfs:label "Genre" ;
    rdfs:comment "A category of media by style or subject (EBUCore genre)." ;
    skos:altLabel "Media Genre" ;
    rdfs:subClassOf :Category .

:Artist a owl:Class ;
    rdfs:label "Artist" ;
    rdfs:comment "A performer, band or creator of media (schema.org MusicGroup, Person)." ;
    skos:altLabel "Performer", "Musician" ;
    rdfs:subClassOf :Agent .

:BroadcastChannel a owl:Class ;
    rdfs:label "Broadcast Channel" ;
    rdfs:comment "A television or radio channel that carries programmes (schema.org BroadcastChannel, EBUCore PublicationChannel)." ;
    skos:altLabel "TV Channel", "Station" ;
    rdfs:subClassOf bfo:0000031 .

:ChannelLineup a owl:Class ;
    rdfs:label "Channel Lineup" ;
    rdfs:comment "An ordered set of broadcast channels offered by one tuner or provider." ;
    skos:altLabel "Lineup", "Channel Guide" ;
    rdfs:subClassOf :Collection .

:Recording a owl:Class ;
    rdfs:label "Recording" ;
    rdfs:comment "A recorded broadcast event held as a media item (EBUCore recorded event)." ;
    skos:altLabel "Media Recording", "DVR Recording" ;
    rdfs:subClassOf :MediaItem .

:RecordingRule a owl:Class ;
    rdfs:label "Recording Rule" ;
    rdfs:comment "A rule that decides which broadcasts are recorded." ;
    skos:altLabel "Recording Schedule", "Series Recording Rule" ;
    rdfs:subClassOf :Policy .

:LiveStream a owl:Class ;
    rdfs:label "Live Stream" ;
    rdfs:comment "A live broadcast of audio or video in progress (schema.org BroadcastEvent)." ;
    skos:altLabel "Stream", "Live Broadcast" ;
    rdfs:subClassOf :MediaItem .

:Viewer a owl:Class ;
    rdfs:label "Viewer" ;
    rdfs:comment "A person watching a stream; the audience role (ActivityStreams audience)." ;
    skos:altLabel "Stream Viewer", "Audience Member" ;
    rdfs:subClassOf :Role .

:MediaRequest a owl:Class ;
    rdfs:label "Media Request" ;
    rdfs:comment "A request for a title to be acquired for a library." ;
    skos:altLabel "Content Request" ;
    rdfs:subClassOf :WorkItem .

:QualityProfile a owl:Class ;
    rdfs:label "Quality Profile" ;
    rdfs:comment "A preference that fixes the encoding quality to acquire or keep." ;
    skos:altLabel "Encoding Profile", "Quality Preset" ;
    rdfs:subClassOf :Policy .

:Torrent a owl:Class ;
    rdfs:label "Torrent" ;
    rdfs:comment "A peer-to-peer transfer unit that downloads media." ;
    skos:altLabel "Torrent Download", "Download" ;
    rdfs:subClassOf :Artifact .

:Tracker a owl:Class ;
    rdfs:label "Tracker" ;
    rdfs:comment "An endpoint that coordinates the peers of a transfer." ;
    skos:altLabel "Torrent Tracker", "Swarm Tracker" ;
    rdfs:subClassOf :ConfigurationItem .

:GameTitle a owl:Class ;
    rdfs:label "Game Title" ;
    rdfs:comment "A video game work (schema.org VideoGame)." ;
    skos:altLabel "Game", "Video Game", "ROM" ;
    rdfs:subClassOf :CreativeWork .

:GameSystem a owl:Class ;
    rdfs:label "Game System" ;
    rdfs:comment "The console or platform a game runs on (schema.org GamePlayMode platform)." ;
    skos:altLabel "Game Console", "Game Platform" ;
    rdfs:subClassOf :Concept .

:GameSave a owl:Class ;
    rdfs:label "Game Save" ;
    rdfs:comment "The saved progress of a game title." ;
    skos:altLabel "Save Game", "Saved Game" ;
    rdfs:subClassOf :Artifact .

:GameState a owl:Class ;
    rdfs:label "Game State" ;
    rdfs:comment "A snapshot of an emulated game's running state." ;
    skos:altLabel "Save State" ;
    rdfs:subClassOf :Artifact .

:episodeOf a owl:ObjectProperty ;
    rdfs:label "episode of" ;
    rdfs:comment "Links an episode to the series or season it belongs to." ;
    rdfs:domain :MediaEpisode ;
    rdfs:range [ a owl:Class ; owl:unionOf ( :Series :Season ) ] ;
    rdfs:subPropertyOf :partOf .

:seasonOf a owl:ObjectProperty ;
    rdfs:label "season of" ;
    rdfs:comment "Links a season to its series." ;
    rdfs:domain :Season ;
    rdfs:range :Series ;
    rdfs:subPropertyOf :partOf .

:trackOf a owl:ObjectProperty ;
    rdfs:label "track of" ;
    rdfs:comment "Links an audio track to the album it appears on." ;
    rdfs:domain :AudioTrack ;
    rdfs:range :Album ;
    rdfs:subPropertyOf :partOf .

:includesItem a owl:ObjectProperty ;
    rdfs:label "includes item" ;
    rdfs:comment "Links a media collection to a media item it holds." ;
    rdfs:domain :MediaCollection ;
    rdfs:range :MediaItem ;
    rdfs:subPropertyOf :hasPart .

:inLibrary a owl:ObjectProperty ;
    rdfs:label "in library" ;
    rdfs:comment "Links a media item or collection to the library that holds it." ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( :MediaItem :MediaCollection ) ] ;
    rdfs:range :MediaLibrary ;
    rdfs:subPropertyOf :partOf .

:performedBy a owl:ObjectProperty ;
    rdfs:label "performed by" ;
    rdfs:comment "Links a media item or collection to its artist." ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( :MediaItem :MediaCollection ) ] ;
    rdfs:range :Artist .

:hasGenre a owl:ObjectProperty ;
    rdfs:label "has genre" ;
    rdfs:comment "Links a media item or collection to its genre." ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( :MediaItem :MediaCollection ) ] ;
    rdfs:range :Genre .

:stackedIn a owl:ObjectProperty ;
    rdfs:label "stacked in" ;
    rdfs:comment "Links a photo to the asset stack it belongs to." ;
    rdfs:domain :Photo ;
    rdfs:range :AssetStack ;
    rdfs:subPropertyOf :partOf .

:inLineup a owl:ObjectProperty ;
    rdfs:label "in lineup" ;
    rdfs:comment "Links a broadcast channel to a channel lineup." ;
    rdfs:domain :BroadcastChannel ;
    rdfs:range :ChannelLineup ;
    rdfs:subPropertyOf :partOf .

:recordedFrom a owl:ObjectProperty ;
    rdfs:label "recorded from" ;
    rdfs:comment "Links a recording to the broadcast channel it was taken from." ;
    rdfs:domain :Recording ;
    rdfs:range :BroadcastChannel .

:producesRecording a owl:ObjectProperty ;
    rdfs:label "produces recording" ;
    rdfs:comment "Links a recording rule to a recording it caused." ;
    rdfs:domain :RecordingRule ;
    rdfs:range :Recording .

:watches a owl:ObjectProperty ;
    rdfs:label "watches" ;
    rdfs:comment "Links a viewer to the live stream being watched." ;
    rdfs:domain :Viewer ;
    rdfs:range :LiveStream .

:requestsMedia a owl:ObjectProperty ;
    rdfs:label "requests media" ;
    rdfs:comment "Links a media request to the item or collection it asks for." ;
    rdfs:domain :MediaRequest ;
    rdfs:range [ a owl:Class ; owl:unionOf ( :MediaItem :MediaCollection ) ] .

:usesQualityProfile a owl:ObjectProperty ;
    rdfs:label "uses quality profile" ;
    rdfs:comment "Links a media request or library to its quality profile." ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( :MediaRequest :MediaLibrary ) ] ;
    rdfs:range :QualityProfile .

:transfersMedia a owl:ObjectProperty ;
    rdfs:label "transfers media" ;
    rdfs:comment "Links a torrent to the media item or collection it downloads." ;
    rdfs:domain :Torrent ;
    rdfs:range [ a owl:Class ; owl:unionOf ( :MediaItem :MediaCollection ) ] .

:announcedTo a owl:ObjectProperty ;
    rdfs:label "announced to" ;
    rdfs:comment "Links a torrent to a tracker that coordinates it." ;
    rdfs:domain :Torrent ;
    rdfs:range :Tracker .

:saveOf a owl:ObjectProperty ;
    rdfs:label "save of" ;
    rdfs:comment "Links a game save or state to its title." ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( :GameSave :GameState ) ] ;
    rdfs:range :GameTitle .

:playsOn a owl:ObjectProperty ;
    rdfs:label "plays on" ;
    rdfs:comment "Links a game title to the system it runs on." ;
    rdfs:domain :GameTitle ;
    rdfs:range :GameSystem .
