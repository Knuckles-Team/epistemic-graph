@prefix : <http://knuckles.team/kg#> .
@prefix cat: <http://knuckles.team/kg/catalog#> .
@prefix cp: <http://knuckles.team/kg/connector-pack#> .
@prefix bfo: <http://purl.obolibrary.org/obo/BFO_> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix schema: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://knuckles.team/kg/metadata_catalog> a owl:Ontology ;
    rdfs:label "Metadata Catalog Ontology" ;
    rdfs:comment "The metadata catalog EG keeps for every connected source: catalogued assets (connector tools, prompts, skills, data resources and fields), owners and stewards, lineage, the business glossary and the Agent Library with system-prompt candidacy (EG-TYPED-PACKS-R106.1, EG-DECISION-ENGINE-R814.1.1). Aligned to W3C DCAT for the catalog, PROV-O for lineage and attribution, ORG for roles and units, SKOS for the glossary and schema.org Action for tool operations. Every class rolls up to an EG core class." ;
    dcterms:source "W3C DCAT 3, PROV-O, ORG, SKOS; schema.org Action" ;
    owl:imports <http://knuckles.team/kg/core>, <http://knuckles.team/kg/capability>, <http://knuckles.team/kg/orchestration>, <http://knuckles.team/kg/service_operations> .

# -- Catalog and assets (DCAT) -----------------------------------------------------------

cat:Catalog a owl:Class ;
    rdfs:label "Metadata Catalog" ;
    rdfs:comment "The catalog of one graph: every catalogued asset is cat:inCatalog of it." ;
    rdfs:subClassOf cat:Asset, dcat:Catalog .

cat:Asset a owl:Class ;
    rdfs:label "Catalog Asset" ;
    rdfs:comment "Anything the metadata catalog describes: a connector tool, prompt, skill, data resource, field or agent card. BFO:GenericallyDependentContinuant, a dcat:Resource." ;
    rdfs:subClassOf bfo:0000031, dcat:Resource .

cat:DataResource a owl:Class ;
    rdfs:label "Data Resource" ;
    rdfs:comment "A connector data resource or ingest source (for example servicenow-mcp/incidents) that records of one ontology class come from." ;
    rdfs:subClassOf cat:Asset, :Dataset, dcat:Dataset .

cat:Field a owl:Class ;
    rdfs:label "Field" ;
    rdfs:comment "One field of a data resource, bound to the ontology property it carries." ;
    rdfs:subClassOf cat:Asset .

cat:ToolAsset a owl:Class ;
    rdfs:label "Tool Asset" ;
    rdfs:comment "One connector tool (one API operation). cat:actionType names the schema.org Action subtype it performs." ;
    rdfs:subClassOf cat:Asset .

cat:PromptAsset a owl:Class ;
    rdfs:label "Prompt Asset" ;
    rdfs:comment "One connector or Agent Library prompt." ;
    rdfs:subClassOf cat:Asset, :Prompt .

:PromptCandidate a owl:Class ;
    rdfs:label "Prompt Candidate" ;
    rdfs:comment "A prompt that can act as the system prompt of an agent for the tasks it is :systemPromptFor (EG-DECISION-ENGINE-R814.1.1). Candidacy is declared by the prompt (role system, systemPromptFor or useCase metadata), never inferred from text." ;
    rdfs:subClassOf cat:PromptAsset .

cat:SkillAsset a owl:Class ;
    rdfs:label "Skill Asset" ;
    rdfs:comment "One skill document (SKILL.md). It is about a :Skill (cat:describesSkill), it is not the skill." ;
    rdfs:subClassOf cat:Asset, :Document .

cat:AgentAsset a owl:Class ;
    rdfs:label "Agent Asset" ;
    rdfs:comment "An Agent Library entry: an agent card or template describing a :Agent (cat:describesAgent)." ;
    rdfs:subClassOf cat:Asset, :Document .

cp:Connector a owl:Class ;
    rdfs:label "Connector" ;
    rdfs:comment "A connected connector (an MCP server) that serves tools, prompts, skills and data resources. A dcat:DataService." ;
    rdfs:subClassOf :Tool, dcat:DataService .

cat:inCatalog a owl:ObjectProperty ;
    rdfs:label "in catalog" ;
    rdfs:domain cat:Asset ;
    rdfs:range cat:Catalog .

cp:ofConnector a owl:ObjectProperty ;
    rdfs:label "of connector" ;
    rdfs:comment "Links a catalogued asset to the connector that serves it." ;
    rdfs:domain cat:Asset ;
    rdfs:range cp:Connector .

cp:servesClass a owl:ObjectProperty ;
    rdfs:label "serves class" ;
    rdfs:comment "Links an asset to the ontology class whose records it reads, writes or frames." ;
    rdfs:domain cat:Asset ;
    rdfs:range owl:Class .

cp:servesProperty a owl:ObjectProperty ;
    rdfs:label "serves property" ;
    rdfs:domain cat:Field ;
    rdfs:range rdf:Property .

cat:hasField a owl:ObjectProperty ;
    rdfs:label "has field" ;
    rdfs:domain cat:DataResource ;
    rdfs:range cat:Field .

cat:actionType a owl:ObjectProperty ;
    rdfs:label "action type" ;
    rdfs:comment "The schema.org Action subtype a tool performs: schema:SearchAction for a read, schema:CreateAction, schema:UpdateAction or schema:DeleteAction for a write." ;
    rdfs:domain cat:ToolAsset ;
    rdfs:range rdfs:Class .

cat:describesSkill a owl:ObjectProperty ;
    rdfs:label "describes skill" ;
    rdfs:domain cat:SkillAsset ;
    rdfs:range :Skill .

cat:describesAgent a owl:ObjectProperty ;
    rdfs:label "describes agent" ;
    rdfs:domain cat:AgentAsset ;
    rdfs:range :Agent .

cp:packVersion a owl:DatatypeProperty ;
    rdfs:label "pack version" ;
    rdfs:comment "The connector pack contract version (record id) the asset was catalogued from." ;
    rdfs:domain cat:Asset ;
    rdfs:range xsd:string .

cp:digest a owl:DatatypeProperty ;
    rdfs:label "digest" ;
    rdfs:comment "The sha256 content digest of the asset's served definition." ;
    rdfs:domain cat:Asset ;
    rdfs:range xsd:string .

cp:declaredOwner a owl:ObjectProperty ;
    rdfs:label "declared owner" ;
    rdfs:comment "The owner a connector pack declares for itself and its assets." ;
    rdfs:subPropertyOf :ownedBy ;
    rdfs:domain cp:Connector .

# -- Owners and stewards (PROV qualified attribution, ORG roles) ----------------------------

cat:hasOwner a owl:ObjectProperty ;
    rdfs:label "has owner" ;
    rdfs:comment "The accountable owner of an asset or a record (a person, group or organization)." ;
    rdfs:subPropertyOf :ownedBy, prov:wasAttributedTo .

cat:hasSteward a owl:ObjectProperty ;
    rdfs:label "has steward" ;
    rdfs:comment "The steward that manages or supports an asset or a record day to day (for example a ServiceNow managed-by or assignment group)." ;
    rdfs:subPropertyOf prov:wasAttributedTo ;
    rdfs:range bfo:0000004 .

cat:StewardshipAssignment a owl:Class ;
    rdfs:label "Stewardship Assignment" ;
    rdfs:comment "A role-qualified attribution: principal cat:principal holds role cat:role for the asset cat:assignedTo. A prov:Attribution." ;
    rdfs:subClassOf bfo:0000031, prov:Attribution .

cat:assignedTo a owl:ObjectProperty ;
    rdfs:label "assigned to" ;
    rdfs:domain cat:StewardshipAssignment ;
    rdfs:range bfo:0000001 .

cat:principal a owl:ObjectProperty ;
    rdfs:label "principal" ;
    rdfs:subPropertyOf prov:agent ;
    rdfs:domain cat:StewardshipAssignment ;
    rdfs:range bfo:0000004 .

cat:role a owl:ObjectProperty ;
    rdfs:label "role" ;
    rdfs:subPropertyOf prov:hadRole ;
    rdfs:domain cat:StewardshipAssignment ;
    rdfs:range cat:StewardshipRole .

cat:StewardshipRole a owl:Class ;
    rdfs:label "Stewardship Role" ;
    rdfs:comment "A catalog role: owner, steward or custodian. An org:Role." ;
    rdfs:subClassOf :Role, org:Role .

cat:owner a cat:StewardshipRole ;
    rdfs:label "owner" .

cat:steward a cat:StewardshipRole ;
    rdfs:label "steward" .

cat:custodian a cat:StewardshipRole ;
    rdfs:label "custodian" .

cat:flag a owl:DatatypeProperty ;
    rdfs:label "flag" ;
    rdfs:comment "A catalog quality flag on an asset, for example owner_missing." ;
    rdfs:domain cat:Asset ;
    rdfs:range xsd:string .

:AssignmentGroup rdfs:subClassOf org:OrganizationalUnit .

:memberOfGroup rdfs:subPropertyOf org:memberOf .

# -- Lineage (PROV-O) ---------------------------------------------------------------------

:derivedFrom rdfs:subPropertyOf prov:wasDerivedFrom .

cat:lineageTo a owl:ObjectProperty ;
    rdfs:label "lineage to" ;
    rdfs:comment "Upstream to downstream lineage: the inverse of :derivedFrom (prov:wasDerivedFrom). A property path cat:lineageTo+ walks lineage." ;
    owl:inverseOf :derivedFrom .

cat:LineageEdge a owl:Class ;
    rdfs:label "Lineage Edge" ;
    rdfs:comment "A qualified lineage hop from cat:from to cat:to with its hop type. A prov:Derivation." ;
    rdfs:subClassOf bfo:0000031, prov:Derivation .

cat:from a owl:ObjectProperty ;
    rdfs:label "from" ;
    rdfs:domain cat:LineageEdge ;
    rdfs:range bfo:0000001 .

cat:to a owl:ObjectProperty ;
    rdfs:label "to" ;
    rdfs:domain cat:LineageEdge ;
    rdfs:range bfo:0000001 .

cat:hop a owl:DatatypeProperty ;
    rdfs:label "hop" ;
    rdfs:comment "The lineage hop type: connector, operation, resource, field, ingest or transform." ;
    rdfs:domain cat:LineageEdge ;
    rdfs:range xsd:string .

cat:fromSource a owl:ObjectProperty ;
    rdfs:label "from source" ;
    rdfs:comment "Links an ingested record to the data resource it was read from." ;
    rdfs:subPropertyOf :derivedFrom ;
    rdfs:range cat:DataResource .

cat:IngestRun a owl:Class ;
    rdfs:label "Ingest Run" ;
    rdfs:comment "One source synchronisation that generated records (prov:wasGeneratedBy), associated with its connector and the tool it used. A prov:Activity." ;
    rdfs:subClassOf bfo:0000015, prov:Activity .

# -- Glossary (SKOS) ----------------------------------------------------------------------

cat:Glossary a owl:Class ;
    rdfs:label "Business Glossary" ;
    rdfs:subClassOf bfo:0000031, skos:ConceptScheme .

cat:GlossaryTerm a owl:Class ;
    rdfs:label "Glossary Term" ;
    rdfs:comment "A business term (skos:prefLabel, skos:altLabel, skos:definition) that names an ontology class and the assets that serve it." ;
    rdfs:subClassOf :Concept, skos:Concept .

cat:definesClass a owl:ObjectProperty ;
    rdfs:label "defines class" ;
    rdfs:domain cat:GlossaryTerm ;
    rdfs:range owl:Class .

:definesAsset a owl:ObjectProperty ;
    rdfs:label "defines asset" ;
    rdfs:comment "Links a glossary term to an asset that serves the class the term names (EG-TYPED-PACKS-R801.2)." ;
    rdfs:domain cat:GlossaryTerm ;
    rdfs:range cat:Asset .
