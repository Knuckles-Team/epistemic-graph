# Connector-pack surface shapes (MEDULLA-TYPED-PACKS-R102.1).
#
# SHACL Core only (DECIDE §4.8): the connector-pack module ships its shapes in
# the same core source as its ontology (the connector-pack CoreSpec shapes
# field), the pattern every other shapes companion follows. The surface shapes
# guard the connector-surface vocabulary of core:connector-pack@1 — one
# component id per tool, a domain link per tool, and a realised-by member per
# feature. The contract shapes (MEDULLA-TYPED-PACKS-R101.2) land beside these,
# never replacing them.

@prefix cp:  <http://knuckles.team/kg/connector-pack#> .
@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cp:ToolShape a sh:NodeShape ;
    sh:targetClass cp:Tool ;
    sh:property [
        sh:path cp:componentId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:message "A tool names exactly one component id."
    ] ;
    sh:or (
        [ sh:property [ sh:path cp:operatesOn ; sh:minCount 1 ;
            sh:message "A tool operates on at least one domain class." ] ]
        [ sh:property [ sh:path cp:providesCapability ; sh:minCount 1 ;
            sh:message "A tool provides at least one capability." ] ]
    ) ;
    sh:message "A tool names one component id and at least one operatesOn or providesCapability domain link." .

cp:FeatureShape a sh:NodeShape ;
    sh:targetClass cp:Feature ;
    sh:property [
        sh:path cp:realizedBy ; sh:minCount 1 ;
        sh:message "A feature is realised by at least one tool, prompt or skill."
    ] ;
    sh:message "A feature names at least one realised-by member." .
