# Infrastructure shapes: the ABox records the container-registry and
# home-assistant connectors write under the infrastructure module, and the
# host-limit rows (EG-SUPPLY-VOCAB-R004.2). SHACL Core only (DECIDE §4.8).
# Counters are bounded from below so a negative registry pull count is a
# violation, not a plausible metric (precedent: finance-v1.shapes.ttl).
# Further infrastructure shapes land beside these, never replacing them.

@prefix :    <http://knuckles.team/kg/infrastructure#> .
@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:ContainerImageShape a sh:NodeShape ;
    sh:description "A container image carries a non-negative registry pull count." ;
    sh:name "Container Image Shape" ;
    sh:property [ sh:minInclusive 0 ;
            sh:message "pullCount must be at least 0." ;
            sh:path :pullCount ] ;
    sh:targetClass :ContainerImage .

:HostLimitShape a sh:NodeShape ;
    sh:targetClass :HostLimit ;
    sh:property [
        sh:path :limitOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:class :Host ;
        sh:message "A HostLimit row constrains exactly one host."
    ] ;
    sh:property [
        sh:path :limitKind ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "temperature" "disk" "memory" "cpu" ) ;
        sh:message "limitKind is temperature, disk, memory or cpu."
    ] ;
    sh:property [
        sh:path :readingValue ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A HostLimit row carries exactly one reading."
    ] ;
    sh:property [
        sh:path :limitValue ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A HostLimit row carries exactly one declared limit."
    ] ;
    sh:message "A host limit names its host, kind, one reading and one limit." .
