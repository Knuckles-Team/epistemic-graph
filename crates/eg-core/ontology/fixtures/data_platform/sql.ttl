# sql store-mapping fixture (EG-DATAPLAT-VOCAB-R006.1).
#
# One attached PostgreSQL database. Discovery is engine-side (R2RML virtual
# graph over the attached catalog, unified-data-plane R003) with the sql_schema
# MCP actions as the fallback discovery path, so contractKind is r2rml-sql and
# the viaOperation records that fallback. All mappings are virtual: rows stay
# in the source and only catalog metadata is held (decision 4).

@prefix dp: <http://knuckles.team/kg/data-platform#> .
@prefix vg: <http://knuckles.team/kg/virtual-graph#> .
@prefix ex: <http://knuckles.team/kg/fixtures/data-platform/sql/> .

ex:store a dp:Database ;
    dp:storeFamily "relational" ;
    dp:sqlDialect "postgresql" .

ex:contract a vg:MetadataContract ;
    vg:contractSource <http://knuckles.team/kg/fixtures/data-platform/sql/connection> ;
    vg:schemaVersion "1" ;
    vg:contentDigest "sha256:16f5216c9eb1024252d092b6aa4aafd663e1c9585b9279361000ff1fc7e8a52a" ;
    vg:discoveredEntity "tables" ;
    vg:discoveredEntity "columns" ;
    vg:discoveredEntity "foreign_keys" ;
    vg:discoveredEntity "constraints" ;
    vg:discoveredField "table_name" ;
    vg:discoveredField "schema_name" ;
    vg:discoveredField "column_name" ;
    vg:discoveredField "is_primary_key" ;
    vg:discoveredField "fk_name" ;
    vg:discoveredField "constraint_name" ;
    vg:discoveredField "referenced_table" .

ex:mapping_tables a dp:StoreMapping ;
    vg:mapsContract ex:contract ;
    vg:mapsOntologyClass dp:Table ;
    vg:mapsEntity "tables" ;
    vg:keyField "table_name" ;
    vg:hasPredicateFieldPair [
        a vg:PredicateFieldPair ;
        vg:predicate dp:inSchema ;
        vg:field "schema_name"
    ] ;
    vg:approved true ;
    dp:inStore ex:store ;
    dp:contractKind "r2rml-sql" ;
    dp:viaOperation "sql_schema:tables" ;
    dp:accelerationMode "virtual" .

ex:mapping_columns a dp:StoreMapping ;
    vg:mapsContract ex:contract ;
    vg:mapsOntologyClass dp:Column ;
    vg:mapsEntity "columns" ;
    vg:keyField "column_name" ;
    vg:hasPredicateFieldPair [
        a vg:PredicateFieldPair ;
        vg:predicate dp:isPrimaryKey ;
        vg:field "is_primary_key"
    ] ;
    vg:approved true ;
    dp:inStore ex:store ;
    dp:contractKind "r2rml-sql" ;
    dp:viaOperation "sql_schema:columns" ;
    dp:accelerationMode "virtual" .

ex:mapping_foreign_keys a dp:StoreMapping ;
    vg:mapsContract ex:contract ;
    vg:mapsOntologyClass dp:ForeignKey ;
    vg:mapsEntity "foreign_keys" ;
    vg:keyField "fk_name" ;
    vg:hasPredicateFieldPair [
        a vg:PredicateFieldPair ;
        vg:predicate dp:referencesTable ;
        vg:field "referenced_table"
    ] ;
    vg:approved true ;
    dp:inStore ex:store ;
    dp:contractKind "r2rml-sql" ;
    dp:viaOperation "sql_schema:foreign_keys" ;
    dp:accelerationMode "virtual" .

ex:mapping_constraints a dp:StoreMapping ;
    vg:mapsContract ex:contract ;
    vg:mapsOntologyClass dp:ForeignKey ;
    vg:mapsEntity "constraints" ;
    vg:keyField "constraint_name" ;
    vg:hasPredicateFieldPair [
        a vg:PredicateFieldPair ;
        vg:predicate dp:referencesTable ;
        vg:field "referenced_table"
    ] ;
    vg:approved true ;
    dp:inStore ex:store ;
    dp:contractKind "r2rml-sql" ;
    dp:viaOperation "sql_schema:constraints" ;
    dp:accelerationMode "virtual" .
