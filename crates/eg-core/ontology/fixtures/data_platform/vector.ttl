# vector store-mapping fixture (EG-DATAPLAT-VOCAB-R006.4).
#
# One attached vector store. Collection listing is a named MCP operation;
# search actions resolve hit ids to source documents and are out of this
# fixture. Collection stats (count, dimension, embedding model, distance
# metric per collection) are BLOCKED on vector-mcp adding a stats action
# (EG-DATAPLAT-VOCAB-R009.2) — the mapping therefore projects only the
# collection's distance metric today. Virtual: no vectors are ever copied
# (decision 4).

@prefix dp: <http://knuckles.team/kg/data-platform#> .
@prefix vg: <http://knuckles.team/kg/virtual-graph#> .
@prefix ex: <http://knuckles.team/kg/fixtures/data-platform/vector/> .

ex:store a dp:DataStore ;
    dp:storeFamily "vector" .

ex:contract a vg:MetadataContract ;
    vg:contractSource <http://knuckles.team/kg/fixtures/data-platform/vector/connection> ;
    vg:schemaVersion "1" ;
    vg:contentDigest "sha256:2724278b4092d567552e0dbb08434fed31fc4c35d35988043b7356e358b8ebfb" ;
    vg:discoveredEntity "collections" ;
    vg:discoveredField "collection_name" ;
    vg:discoveredField "distance_metric" .

ex:mapping_list_collections a dp:StoreMapping ;
    vg:mapsContract ex:contract ;
    vg:mapsOntologyClass dp:VectorCollection ;
    vg:mapsEntity "collections" ;
    vg:keyField "collection_name" ;
    vg:hasPredicateFieldPair [
        a vg:PredicateFieldPair ;
        vg:predicate dp:distanceMetric ;
        vg:field "distance_metric"
    ] ;
    vg:approved true ;
    dp:inStore ex:store ;
    dp:contractKind "mcp-operation" ;
    dp:viaOperation "vector_collection_management:list_collections" ;
    dp:accelerationMode "virtual" .
