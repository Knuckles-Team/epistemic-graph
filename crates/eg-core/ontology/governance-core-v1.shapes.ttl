@prefix fibo-fi: <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/> .
@prefix fibo-org: <https://spec.edmcouncil.org/fibo/ontology/FND/Organizations/Organizations/> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix : <http://knuckles.team/kg#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
:ADRShape a sh:NodeShape ;
    sh:description "ADRs must capture context, decision, and authority." ;
    sh:name "Architecture Decision Record Shape" ;
    sh:property [ sh:datatype xsd:string ;
            sh:message "ADR must have a context describing why the decision was needed." ;
            sh:minCount 1 ;
            sh:path :context ],
        [ sh:datatype xsd:string ;
            sh:message "ADR must have a decision describing what was decided." ;
            sh:minCount 1 ;
            sh:path :decision ],
        [ sh:datatype xsd:string ;
            sh:message "ADR must have an authority identifying who approved it." ;
            sh:minCount 1 ;
            sh:path :authority ] ;
    sh:targetClass :ArchitectureDecisionRecord .

:CapabilityShape a sh:NodeShape ;
    sh:description "ServiceCapability instances must be named and carry their abstract capability category." ;
    sh:name "Service Capability Shape" ;
    sh:property [ sh:datatype xsd:string ;
            sh:message "Capability must have a name." ;
            sh:minCount 1 ;
            sh:path :name ],
        [ sh:datatype xsd:string ;
            sh:message "Capability must declare its capabilityCategory." ;
            sh:minCount 1 ;
            sh:path :capabilityCategory ] ;
    sh:targetClass :ServiceCapability .

:PolicyShape a sh:NodeShape ;
    sh:description "Policies should be linked to the concepts they govern." ;
    sh:name "Policy Shape" ;
    sh:property [ sh:message "Policy should be linked to at least one Concept via motivatedBy." ;
            sh:minCount 0 ;
            sh:path :motivatedBy ;
            sh:severity sh:Warning ] ;
    sh:targetClass :Policy .

:ToolShape a sh:NodeShape ;
    sh:description "Tools are concrete platform/service instances and must be named and classified by the capability they provide." ;
    sh:name "Tool Shape" ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "Tool must have exactly one name." ;
            sh:minCount 1 ;
            sh:path :name ],
        [ sh:datatype xsd:string ;
            sh:message "Tool must declare at least one capabilityCategory it provides." ;
            sh:minCount 1 ;
            sh:path :capabilityCategory ] ;
    sh:targetClass :Tool .

# ── World-model ABox shapes (ruling 2026-09-22, night) ─────────────────────────
# Records ingested by connectors under world_model-v1.ttl. sh:class checks the
# value's asserted rdf:type (no subclass closure), so it is used only where the
# connector asserts that exact class; places are checked by node kind.

:TaxonShape a sh:NodeShape ;
    sh:description "An ingested taxon is an individual with one scientific name, one source identifier, at most one rank and at most one parent taxon." ;
    sh:name "Taxon Shape" ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "Taxon must have exactly one scientificName." ;
            sh:minCount 1 ;
            sh:path :scientificName ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "Taxon must carry exactly one termCurie (e.g. NCBITaxon:9606 or GBIF:5219243)." ;
            sh:minCount 1 ;
            sh:path :termCurie ],
        [ sh:class :TaxonRank ;
            sh:maxCount 1 ;
            sh:message "Taxon has at most one taxonRank, a TaxonRank individual." ;
            sh:path :taxonRank ],
        [ sh:class :Taxon ;
            sh:maxCount 1 ;
            sh:message "Taxon has at most one parentTaxon, itself a Taxon." ;
            sh:path :parentTaxon ],
        [ sh:maxCount 1 ;
            sh:message "ncbiTaxonId is a decimal NCBI Taxonomy id." ;
            sh:path :ncbiTaxonId ;
            sh:pattern "^[0-9]+$" ] ;
    sh:targetClass :Taxon .

:OrganismObservationShape a sh:NodeShape ;
    sh:description "An occurrence record names the identified taxon, when it was observed and where." ;
    sh:name "Organism Observation Shape" ;
    sh:property [ sh:class :Taxon ;
            sh:maxCount 1 ;
            sh:message "Organism observation must identify exactly one observedTaxon." ;
            sh:minCount 1 ;
            sh:path :observedTaxon ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:message "Organism observation must have exactly one observationTime." ;
            sh:minCount 1 ;
            sh:path :observationTime ],
        [ sh:message "Organism observation must say where it occurredAt (a Place, Region or Habitat IRI)." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path :occurredAt ] ;
    sh:targetClass :OrganismObservation .

:WeatherObservationShape a sh:NodeShape ;
    sh:description "A weather observation is one measured quality with a value, a unit, a time and a place." ;
    sh:name "Weather Observation Shape" ;
    sh:property [ sh:class :QualityTerm ;
            sh:maxCount 1 ;
            sh:message "Weather observation must name exactly one observedQuality." ;
            sh:minCount 1 ;
            sh:path :observedQuality ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:message "Weather observation must have exactly one quantityValue." ;
            sh:minCount 1 ;
            sh:path :quantityValue ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "Weather observation must have exactly one UCUM unitCode." ;
            sh:minCount 1 ;
            sh:path :unitCode ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:message "Weather observation must have exactly one observationTime." ;
            sh:minCount 1 ;
            sh:path :observationTime ],
        [ sh:message "Weather observation must say where it occurredAt (a station Place or Region IRI)." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path :occurredAt ] ;
    sh:targetClass :WeatherObservation .

:FoodCompositionRecordShape a sh:NodeShape ;
    sh:description "A food-composition record describes one food and lists its nutrient amounts." ;
    sh:name "Food Composition Record Shape" ;
    sh:property [ sh:class :FoodTerm ;
            sh:maxCount 1 ;
            sh:message "Food composition record must describe exactly one FoodTerm." ;
            sh:minCount 1 ;
            sh:path :describesFood ],
        [ sh:class :NutrientAmount ;
            sh:message "Food composition record must list at least one NutrientAmount." ;
            sh:minCount 1 ;
            sh:path :hasNutrientAmount ] ;
    sh:targetClass :FoodCompositionRecord .

:NutrientAmountShape a sh:NodeShape ;
    sh:description "A nutrient amount is one nutrient with a non-negative value and a unit." ;
    sh:name "Nutrient Amount Shape" ;
    sh:property [ sh:class :Nutrient ;
            sh:maxCount 1 ;
            sh:message "Nutrient amount must name exactly one Nutrient." ;
            sh:minCount 1 ;
            sh:path :amountOfNutrient ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:message "Nutrient amount must have exactly one non-negative quantityValue." ;
            sh:minCount 1 ;
            sh:minInclusive 0.0 ;
            sh:path :quantityValue ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "Nutrient amount must have exactly one UCUM unitCode." ;
            sh:minCount 1 ;
            sh:path :unitCode ] ;
    sh:targetClass :NutrientAmount .
