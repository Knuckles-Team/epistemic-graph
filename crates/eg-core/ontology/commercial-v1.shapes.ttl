# Commercial shapes (EG-SUPPLY-VOCAB-R003.14).
#
# SHACL Core only (DECIDE §4.8): the commercial module ships its shapes in the
# same core source as its ontology (the commercial CoreSpec shapes field), the
# pattern every other shapes companion follows. The contract shape guards
# EG-CQ-XSRC-R008.3.1; further commercial shapes land beside these, never
# replacing them.

@prefix kg:  <http://knuckles.team/kg#> .
@prefix infra: <http://knuckles.team/kg/infrastructure#> .
@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

kg:CustomerContractShape a sh:NodeShape ;
    sh:targetClass kg:CustomerContract ;
    sh:property [
        sh:path kg:contractCustomer ; sh:minCount 1 ; sh:maxCount 1 ; sh:class kg:Customer ;
        sh:message "A CustomerContract names exactly one customer."
    ] ;
    sh:property [
        sh:path kg:coversService ; sh:minCount 1 ; sh:class infra:Service ;
        sh:message "A CustomerContract covers at least one service."
    ] ;
    sh:message "A contract names a customer and at least one covered service." .

kg:SupportsCapabilityShape a sh:NodeShape ;
    sh:targetClass infra:Service ;
    sh:property [
        sh:path kg:supportsCapability ; sh:class kg:BusinessCapability ;
        sh:message "A capability link points from a service to a BusinessCapability."
    ] ;
    sh:message "Only a service carries a capability link -- a link from a non-service is refused." .
