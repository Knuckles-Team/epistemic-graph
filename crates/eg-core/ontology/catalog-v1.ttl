@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://knuckles.team/kg> a owl:Ontology ;
    rdfs:label "Epistemic Graph Core Ontology Catalog" ;
    rdfs:comment "Generated aggregate catalog for the immutable ontology modules shipped by epistemic-graph." ;
