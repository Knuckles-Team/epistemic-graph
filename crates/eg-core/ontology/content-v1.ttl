@prefix : <http://knuckles.team/kg#> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://knuckles.team/kg/content> a owl:Ontology ;
    rdfs:label "Content Channel Ontology" ;
    rdfs:comment "Content-channel concepts: feeds and articles, research papers, search queries and results, social posts and channels, email campaigns and mailing lists, and message channels with chat. Reuses CreativeWork, Document, Message, Person, Team and the search terms from the core and retrieval modules (EG-MEDIA-VOCAB-R002)." ;
    owl:imports <http://knuckles.team/kg/core>, <http://knuckles.team/kg/retrieval> .

# --- content vocab lane A ---
# The `cv:` names in the spec rows are documentation prefixes for this module's
# section of the shared `:` namespace (specs/media-and-personal-vocabulary/
# plan.md, "Vocabulary"); every IRI stays in `:` like the other ontology files,
# and the existing core/retrieval terms are reused, never redeclared.

# R002.1: feeds, articles and research papers.

:Feed a owl:Class ;
    rdfs:label "Feed" ;
    rdfs:comment "A feed of articles, for example an RSS feed (FreshRSS feed)." ;
    rdfs:subClassOf :CreativeWork .

:FeedSubscription a owl:Class ;
    rdfs:label "Feed Subscription" ;
    rdfs:comment "One reader's subscription to a feed (FreshRSS subscription)." .

:ofFeed a owl:ObjectProperty ;
    rdfs:label "of feed" ;
    rdfs:comment "Links a feed subscription to the feed it subscribes to." ;
    rdfs:domain :FeedSubscription ;
    rdfs:range :Feed .

:Article a owl:Class ;
    rdfs:label "Article" ;
    rdfs:comment "A feed article or web article; the content document a feed delivers." ;
    rdfs:subClassOf :Document .

:ResearchPaper a owl:Class ;
    rdfs:label "Research Paper" ;
    rdfs:comment "A research paper with its identifiers and citation count (ScholarX paper)." ;
    rdfs:seeAlso bibo:AcademicArticle ;
    rdfs:subClassOf :Document .

# R002.2: social posts, publishing channels, email campaigns and lists.
# SearchQuery, SearchResult and SearchEngine are reused from retrieval-v1
# without redeclaration.

:SocialPost a owl:Class ;
    rdfs:label "Social Post" ;
    rdfs:comment "A post published or scheduled on a social channel (Postiz post)." .

:PublishingChannel a owl:Class ;
    rdfs:label "Publishing Channel" ;
    rdfs:comment "A social platform channel a publisher posts to (Postiz integration)." ;
    skos:altLabel "Social Channel", "Social Platform" .

:EngagementMetric a owl:Class ;
    rdfs:label "Engagement Metric" ;
    rdfs:comment "One engagement measurement of a social post (Postiz analytics: impressions, likes)." .

:metricOf a owl:ObjectProperty ;
    rdfs:label "metric of" ;
    rdfs:comment "Links an engagement metric to the social post it measures." ;
    rdfs:domain :EngagementMetric ;
    rdfs:range :SocialPost .

:channelOf a owl:ObjectProperty ;
    rdfs:label "channel of" ;
    rdfs:comment "Links a social post to the publishing channel it was posted on." ;
    rdfs:domain :SocialPost ;
    rdfs:range :PublishingChannel .

:EmailCampaign a owl:Class ;
    rdfs:label "Email Campaign" ;
    rdfs:comment "A mailing campaign sent to one or more lists (Listmonk campaign)." .

:MailingList a owl:Class ;
    rdfs:label "Mailing List" ;
    rdfs:comment "A list of subscribers addressed by email campaigns (Listmonk list)." .

:Subscriber a owl:Class ;
    rdfs:label "Subscriber" ;
    rdfs:comment "A mailing-list subscriber with an opaque identity: only the keyed hash of the address, never the raw address (EG-MEDIA-VOCAB-R003.3)." .

:sentToList a owl:ObjectProperty ;
    rdfs:label "sent to list" ;
    rdfs:comment "Links an email campaign to a mailing list it was sent to." ;
    rdfs:domain :EmailCampaign ;
    rdfs:range :MailingList .

:postState a owl:DatatypeProperty ;
    rdfs:label "post state" ;
    rdfs:comment "The publish state of a social post, for example draft, scheduled, published or failed." ;
    rdfs:domain :SocialPost ;
    rdfs:range xsd:string .

:socialScheduledAt a owl:DatatypeProperty ;
    rdfs:label "social scheduled at" ;
    rdfs:comment "Time a social post is scheduled to publish. Distinct from :scheduledFor, which links CalendarEvent to Person." ;
    rdfs:domain :SocialPost ;
    rdfs:range xsd:dateTime .

:sentCount a owl:DatatypeProperty ;
    rdfs:label "sent count" ;
    rdfs:comment "How many recipients an email campaign was sent to." ;
    rdfs:domain :EmailCampaign ;
    rdfs:range xsd:nonNegativeInteger .

:viewCount a owl:DatatypeProperty ;
    rdfs:label "view count" ;
    rdfs:comment "How many recipients viewed the email campaign." ;
    rdfs:domain :EmailCampaign ;
    rdfs:range xsd:nonNegativeInteger .

:clickCount a owl:DatatypeProperty ;
    rdfs:label "click count" ;
    rdfs:comment "How many tracked links of the email campaign were clicked." ;
    rdfs:domain :EmailCampaign ;
    rdfs:range xsd:nonNegativeInteger .

:subscriptionStatus a owl:DatatypeProperty ;
    rdfs:label "subscription status" ;
    rdfs:comment "The subscription state of a subscriber, for example subscribed, unsubscribed or complained." ;
    rdfs:domain :Subscriber ;
    rdfs:range xsd:string .

# R002.3: message channels and chat. kg:Team is reused from
# core-foundation-v1 without redeclaration.

:MessageChannel a owl:Class ;
    rdfs:label "Message Channel" ;
    rdfs:comment "A chat channel or room (Mattermost channel, Owncast chat room)." .

:ChatMessage a owl:Class ;
    rdfs:label "Chat Message" ;
    rdfs:comment "One message posted to a message channel." ;
    rdfs:subClassOf :Message .

:memberCount a owl:DatatypeProperty ;
    rdfs:label "member count" ;
    rdfs:comment "How many members a message channel has." ;
    rdfs:domain :MessageChannel ;
    rdfs:range xsd:nonNegativeInteger .

:lastPostAt a owl:DatatypeProperty ;
    rdfs:label "last post at" ;
    rdfs:comment "Time the message channel last received a post; unbound means never posted." ;
    rdfs:domain :MessageChannel ;
    rdfs:range xsd:dateTime .

:postedAt a owl:DatatypeProperty ;
    rdfs:label "posted at" ;
    rdfs:comment "Time a chat message was posted." ;
    rdfs:domain :ChatMessage ;
    rdfs:range xsd:dateTime .

:postedBy a owl:ObjectProperty ;
    rdfs:label "posted by" ;
    rdfs:comment "Links a chat message to the person who posted it." ;
    rdfs:domain :ChatMessage ;
    rdfs:range :Person .

# R002.4: shared content properties.

:feedUrl a owl:DatatypeProperty ;
    rdfs:label "feed URL" ;
    rdfs:comment "The URL a feed or feed subscription is read from." ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( :Feed :FeedSubscription ) ] ;
    rdfs:range xsd:string .

:publishedAt a owl:DatatypeProperty ;
    rdfs:label "published at" ;
    rdfs:comment "Time an article, paper or social post was published." ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( :Article :ResearchPaper :SocialPost ) ] ;
    rdfs:range xsd:dateTime .

:isRead a owl:DatatypeProperty ;
    rdfs:label "is read" ;
    rdfs:comment "True once the reader has read the article (FreshRSS read state)." ;
    rdfs:domain :Article ;
    rdfs:range xsd:boolean .

:resultUrl a owl:DatatypeProperty ;
    rdfs:label "result URL" ;
    rdfs:comment "The source URL of one search result as returned by the engine." ;
    rdfs:domain :SearchResult ;
    rdfs:range xsd:string .

:rank a owl:DatatypeProperty ;
    rdfs:label "rank" ;
    rdfs:comment "The position of a search result within its query's result list." ;
    rdfs:domain :SearchResult ;
    rdfs:range xsd:nonNegativeInteger .

:servedByEngine a owl:ObjectProperty ;
    rdfs:label "served by engine" ;
    rdfs:comment "Links a search result to the search engine that served it (SearXNG per-result engine)." ;
    rdfs:domain :SearchResult ;
    rdfs:range :SearchEngine .

:doi a owl:DatatypeProperty ;
    rdfs:label "DOI" ;
    rdfs:comment "The DOI of a research paper." ;
    rdfs:domain :ResearchPaper ;
    rdfs:range xsd:string .

:arxivId a owl:DatatypeProperty ;
    rdfs:label "arXiv ID" ;
    rdfs:comment "The arXiv identifier of a research paper." ;
    rdfs:domain :ResearchPaper ;
    rdfs:range xsd:string .

:citationCount a owl:DatatypeProperty ;
    rdfs:label "citation count" ;
    rdfs:comment "How many papers cite the research paper (count only: the citing papers are not modelled)." ;
    rdfs:domain :ResearchPaper ;
    rdfs:range xsd:nonNegativeInteger .

# R003.1: cross-source identity key. Article identity uses its class-scoped
# normalised canonical URL; a URL join does not create owl:sameAs between a
# document and the search results or posts that reference it. No global
# inverse-functionality is declared.

:canonicalUrl a owl:DatatypeProperty ;
    rdfs:label "canonical URL" ;
    rdfs:comment "The normalised document URL of an article or search result, and the shared target URL a post or campaign links to. Normalisation: scheme and host lower-cased, tracking parameters and fragment stripped. Shared target URLs support joins without identifying the result, post, campaign and document as one entity." ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( :Article :SearchResult :SocialPost :EmailCampaign ) ] ;
    rdfs:range xsd:string .

# R003.3: keyed-hash identity for email-derived joins; the raw address is
# never stored.

:subscriberKey a owl:DatatypeProperty ;
    rdfs:label "subscriber key" ;
    rdfs:comment "The keyed hash of a subscriber's email address; the only identity a Subscriber carries. The raw address is never stored (connector governance: identity opaque-reference)." ;
    rdfs:domain :Subscriber ;
    rdfs:range xsd:string .

# R013.1: the per-feed unread count (FreshRSS unread-count).

:unreadCount a owl:DatatypeProperty ;
    rdfs:label "unread count" ;
    rdfs:comment "The number of unread articles a feed currently has (FreshRSS per-stream unread count)." ;
    rdfs:domain :Feed ;
    rdfs:range xsd:nonNegativeInteger .
