# Recorded virtual-graph mapping for the `audio-transcriber` connector
# (audio-transcriber; MEDULLA-MEDIA-VOCAB-R012.1, MEDULLA-CQ-CONN-R008). The rows are the
# `Connector mapping tables` entry for audio-transcriber in
# specs/media-and-personal-vocabulary/plan.md (operation -> class/property ->
# contract kind), written as `vg:VirtualMapping` rows over the `vg:` vocabulary
# in virtual_graph-v1.ttl and shaped by virtual_graph-v1.shapes.ttl. `mv:` is a
# documentation prefix for this section of the shared `http://knuckles.team/kg#`
# namespace; every ontology IRI stays in `:`.
#
# The transcript terms are reused from personal-v1 (Transcript,
# TranscriptSegment, segmentOf, transcribedFrom), never redeclared; the segment
# fields segmentStart / segmentEnd / noSpeechProb come from media-v1. The
# connector transcribes on demand and has no list/get operation for past
# transcripts, so the single-source question abstains (plan.md). The metadata
# contract is the discovery of the recorded response
# (audio-transcriber_response.json, same directory); vg:contentDigest is
# sha256 over its bytes.

@prefix :    <http://knuckles.team/kg#> .
@prefix vg:  <http://knuckles.team/kg/virtual-graph#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix f:   <urn:eg-media-vocab:audio-transcriber/> .

f:connection a vg:SourceConnection ;
    vg:sourceKind "mcp" ;
    vg:declaredCapability "read" ;
    vg:endpointRef [ a vg:EndpointRef ; vg:url "https://mcp.example.invalid/audio-transcriber" ] .

f:contract a vg:MetadataContract ;
    vg:contractSource f:connection ;
    vg:schemaVersion "1" ;
    vg:contentDigest "sha256:881d4efdd8df1ad5b4bc6e8d0ac0bc3fce627528eb3e0846c2bd848cf4240b66" ;
    vg:discoveredEntity "Transcript", "Segment", "IngestedTranscript" ;
    vg:discoveredField "id", "recording", "text", "start", "end", "noSpeechProb", "transcript", "blob" ;
    vg:discoveredOperation "audio_transcriber/transcribe_audio", "audio_transcriber/transcribe_media", "audio_transcriber/audio_ingest_transcription" .

# transcribe_audio / transcribe_media: the transcript, reused from personal-v1
f:row-transcript a vg:VirtualMapping ;
    vg:mapsContract f:contract ;
    vg:mapsOntologyClass :Transcript ;
    vg:mapsEntity "Transcript" ;
    vg:keyField "id" ;
    vg:approved "true"^^xsd:boolean ;
    vg:hasPredicateFieldPair [
        a vg:PredicateFieldPair ;
        vg:predicate :transcribedFrom ;
        vg:field "recording"
    ], [
        a vg:PredicateFieldPair ;
        vg:predicate :text ;
        vg:field "text"
    ] .

# transcribe_audio / transcribe_media: the Whisper segments
f:row-segment a vg:VirtualMapping ;
    vg:mapsContract f:contract ;
    vg:mapsOntologyClass :TranscriptSegment ;
    vg:mapsEntity "Segment" ;
    vg:keyField "id" ;
    vg:approved "true"^^xsd:boolean ;
    vg:hasPredicateFieldPair [
        a vg:PredicateFieldPair ;
        vg:predicate :segmentStart ;
        vg:field "start"
    ], [
        a vg:PredicateFieldPair ;
        vg:predicate :segmentEnd ;
        vg:field "end"
    ], [
        a vg:PredicateFieldPair ;
        vg:predicate :noSpeechProb ;
        vg:field "noSpeechProb"
    ], [
        a vg:PredicateFieldPair ;
        vg:predicate :text ;
        vg:field "text"
    ], [
        a vg:PredicateFieldPair ;
        vg:predicate :segmentOf ;
        vg:field "transcript"
    ] .

# audio_ingest_transcription: the ingested transcript with its audio blob
f:row-ingested-transcript a vg:VirtualMapping ;
    vg:mapsContract f:contract ;
    vg:mapsOntologyClass :Transcript ;
    vg:mapsEntity "IngestedTranscript" ;
    vg:keyField "id" ;
    vg:approved "true"^^xsd:boolean ;
    vg:hasPredicateFieldPair [
        a vg:PredicateFieldPair ;
        vg:predicate :transcribedFrom ;
        vg:field "recording"
    ], [
        a vg:PredicateFieldPair ;
        vg:predicate :text ;
        vg:field "text"
    ], [
        a vg:PredicateFieldPair ;
        vg:predicate :hasBlob ;
        vg:field "blob"
    ] .
