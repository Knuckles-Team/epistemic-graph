# Recorded virtual-graph mapping for the `media-downloader` connector
# (media-downloader; MEDULLA-MEDIA-VOCAB-R011.1, MEDULLA-CQ-CONN-R038). The rows are the
# `Connector mapping tables` entry for media-downloader in
# specs/media-and-personal-vocabulary/plan.md (operation -> class/property ->
# contract kind), written as `vg:VirtualMapping` rows over the `vg:` vocabulary
# in virtual_graph-v1.ttl and shaped by virtual_graph-v1.shapes.ttl. `mv:` is a
# documentation prefix for this section of the shared `http://knuckles.team/kg#`
# namespace; every ontology IRI stays in `:`.
#
# The connector exposes only download actions and watch prompts: there is no
# operation that lists past jobs, their status or error, so the single-source
# question abstains (plan.md). The download job is modelled as a
# :DownloadRequest carrying its source URL and state, with the produced file
# linked as a :MediaFile. The metadata contract is the discovery of the
# recorded response (media-downloader_response.json, same directory);
# vg:contentDigest is sha256 over its bytes.

@prefix :    <http://knuckles.team/kg#> .
@prefix vg:  <http://knuckles.team/kg/virtual-graph#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix f:   <urn:eg-media-vocab:media-downloader/> .

f:connection a vg:SourceConnection ;
    vg:sourceKind "mcp" ;
    vg:declaredCapability "read" ;
    vg:endpointRef [ a vg:EndpointRef ; vg:url "https://mcp.example.invalid/media-downloader" ] .

f:contract a vg:MetadataContract ;
    vg:contractSource f:connection ;
    vg:schemaVersion "1" ;
    vg:contentDigest "sha256:d9e8b7dcdb92118fb8dbc7b73f81429bb2615a69abad196d01a1d36a1a01eac4" ;
    vg:discoveredEntity "DownloadJob", "WatchFile" ;
    vg:discoveredField "id", "url", "state", "output", "fileName" ;
    vg:discoveredOperation "media_downloader/download_media", "media_downloader/download_video", "media_downloader/download_audio", "media_downloader/download_directory", "media_downloader/list_watch_skills", "media_downloader/watch_media" .

# download_media / download_video / download_audio / download_directory: a
# download is a request to acquire a file, recorded with its source URL,
# state and produced output
f:row-download-job a vg:VirtualMapping ;
    vg:mapsContract f:contract ;
    vg:mapsOntologyClass :DownloadRequest ;
    vg:mapsEntity "DownloadJob" ;
    vg:keyField "id" ;
    vg:approved "true"^^xsd:boolean ;
    vg:hasPredicateFieldPair [
        a vg:PredicateFieldPair ;
        vg:predicate :downloadSourceUrl ;
        vg:field "url"
    ], [
        a vg:PredicateFieldPair ;
        vg:predicate :downloadRequestState ;
        vg:field "state"
    ], [
        a vg:PredicateFieldPair ;
        vg:predicate :downloadOutput ;
        vg:field "output"
    ] .

# list_watch_skills / watch_media: the watched file is a media file
f:row-watch-file a vg:VirtualMapping ;
    vg:mapsContract f:contract ;
    vg:mapsOntologyClass :MediaFile ;
    vg:mapsEntity "WatchFile" ;
    vg:keyField "id" ;
    vg:approved "true"^^xsd:boolean ;
    vg:hasPredicateFieldPair [
        a vg:PredicateFieldPair ;
        vg:predicate :fileName ;
        vg:field "fileName"
    ] .
