# Recorded virtual-graph mapping for the `freshrss` connector
# (freshrss-agent; MEDULLA-MEDIA-VOCAB-R013.1, MEDULLA-CQ-CONN-R022). The rows are the
# `Connector mapping tables` entry for freshrss in
# specs/media-and-personal-vocabulary/plan.md (operation -> class/property ->
# contract kind), written as `vg:VirtualMapping` rows over the `vg:` vocabulary
# in virtual_graph-v1.ttl and shaped by virtual_graph-v1.shapes.ttl. `mv:` and
# `cv:` are documentation prefixes for this section of the shared
# `http://knuckles.team/kg#` namespace; every ontology IRI stays in `:`.
#
# The feed terms are reused from content-v1 (Feed, FeedSubscription, Article,
# ofFeed, feedUrl, canonicalUrl, publishedAt, isRead) plus the lane A addition
# `:unreadCount` (R013.1); they are never redeclared. `mark_read` (write) is
# effect-only with no contract, so it is not a mapping row. The metadata
# contract is the discovery of the recorded response
# (freshrss_response.json, same directory); vg:contentDigest is sha256 over
# its bytes. The GReader stream ids are feed-scoped, so an article key is
# `<streamId>/<itemId>` and the "given feed" question filters on the key.

@prefix :    <http://knuckles.team/kg#> .
@prefix vg:  <http://knuckles.team/kg/virtual-graph#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix f:   <urn:eg-media-vocab:freshrss/> .

f:connection a vg:SourceConnection ;
    vg:sourceKind "mcp" ;
    vg:declaredCapability "read" ;
    vg:endpointRef [ a vg:EndpointRef ; vg:url "https://mcp.example.invalid/freshrss" ] .

f:contract a vg:MetadataContract ;
    vg:contractSource f:connection ;
    vg:schemaVersion "1" ;
    vg:contentDigest "sha256:316a1fca229be2af550cdf76a7ebce52bfca48d93477335025be963aec489651" ;
    vg:discoveredEntity "Article", "UnreadCount", "Subscription" ;
    vg:discoveredField "id", "title", "url", "publishedAt", "isRead", "text", "count" ;
    vg:discoveredOperation "freshrss_reader/stream_contents", "freshrss_reader/item_contents", "freshrss_reader/unread_count", "freshrss_subscriptions/subscription_list" .

# stream_contents / item_contents: the feed articles
f:row-article a vg:VirtualMapping ;
    vg:mapsContract f:contract ;
    vg:mapsOntologyClass :Article ;
    vg:mapsEntity "Article" ;
    vg:keyField "id" ;
    vg:approved "true"^^xsd:boolean ;
    vg:hasPredicateFieldPair [
        a vg:PredicateFieldPair ;
        vg:predicate :canonicalUrl ;
        vg:field "url"
    ], [
        a vg:PredicateFieldPair ;
        vg:predicate :publishedAt ;
        vg:field "publishedAt"
    ], [
        a vg:PredicateFieldPair ;
        vg:predicate :isRead ;
        vg:field "isRead"
    ], [
        a vg:PredicateFieldPair ;
        vg:predicate :text ;
        vg:field "text"
    ], [
        a vg:PredicateFieldPair ;
        vg:predicate :title ;
        vg:field "title"
    ] .

# unread_count: the per-feed unread count
f:row-unread-count a vg:VirtualMapping ;
    vg:mapsContract f:contract ;
    vg:mapsOntologyClass :Feed ;
    vg:mapsEntity "UnreadCount" ;
    vg:keyField "id" ;
    vg:approved "true"^^xsd:boolean ;
    vg:hasPredicateFieldPair [
        a vg:PredicateFieldPair ;
        vg:predicate :unreadCount ;
        vg:field "count"
    ] .

# subscription_list: the feed subscriptions
f:row-subscription a vg:VirtualMapping ;
    vg:mapsContract f:contract ;
    vg:mapsOntologyClass :FeedSubscription ;
    vg:mapsEntity "Subscription" ;
    vg:keyField "id" ;
    vg:approved "true"^^xsd:boolean ;
    vg:hasPredicateFieldPair [
        a vg:PredicateFieldPair ;
        vg:predicate :feedUrl ;
        vg:field "url"
    ], [
        a vg:PredicateFieldPair ;
        vg:predicate :ofFeed ;
        vg:field "id"
    ], [
        a vg:PredicateFieldPair ;
        vg:predicate :title ;
        vg:field "title"
    ] .
