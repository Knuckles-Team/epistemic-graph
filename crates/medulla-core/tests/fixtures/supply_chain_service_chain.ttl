# Supply-chain physical-chain ABox fixture (MEDULLA-SUPPLY-VOCAB-R001.3).
#
# One supplier supplies one item; the item is realized by one deployed
# asset; the asset is hosted on one host; one independently typed
# Service runs on that host. Under the `kg:suppliesService` property
# chain (suppliesItem, realizedByAsset, assetHost, inverse
# serviceRunsOn) the native reasoner must derive the direct
# supplier-to-service edge. A container-only or pod-only runsOn path
# (separate fixture, inlined in the test) must derive nothing.

@prefix : <http://knuckles.team/kg#> .
@prefix infra: <http://knuckles.team/kg/infrastructure#> .
@prefix ex: <http://knuckles.team/test/supply-chain#> .

ex:acmeSupplier a :Supplier .

ex:acmeSupplier :suppliesItem ex:psuItem .

ex:psuItem a :SupplyChainItem .

ex:psuItem :realizedByAsset ex:psuAsset .

ex:psuAsset a :AssetInstance .

ex:psuAsset :assetHost ex:rackHost .

ex:rackHost a infra:Host .

ex:payrollService a infra:Service .

ex:payrollService infra:serviceRunsOn ex:rackHost .
