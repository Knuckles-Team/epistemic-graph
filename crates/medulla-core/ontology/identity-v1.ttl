@prefix fibo-fi: <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/> .
@prefix fibo-org: <https://spec.edmcouncil.org/fibo/ontology/FND/Organizations/Organizations/> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix : <http://knuckles.team/kg#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:assignedApp a owl:ObjectProperty ;
    rdfs:label "assigned app" ;
    rdfs:comment "Links a user/group to an Application they can access (access governance)." ;
    rdfs:range :Application .

:hasRole a owl:ObjectProperty ;
    rdfs:label "has role" ;
    rdfs:range :IdentityRole .

:memberOfGroup a owl:ObjectProperty ;
    rdfs:label "member of group" ;
    rdfs:domain :IdentityUser ;
    rdfs:range :IdentityGroup .

<http://knuckles.team/kg/identity> a owl:Ontology ;
    rdfs:label "Identity & Access Ontology" ;
    rdfs:comment "Users/groups/roles/app-assignments for cross-tool access governance (CONCEPT:KG-2.9)." ;
    owl:imports <http://knuckles.team/kg/core> .

:IdentityGroup a owl:Class ;
    rdfs:label "Identity Group" ;
    rdfs:comment "A group/team of users in an identity provider." .

:IdentityRole a owl:Class ;
    rdfs:label "Identity Role" ;
    rdfs:comment "A role/entitlement granted to users or groups." .

:IdentityUser a owl:Class ;
    rdfs:label "Identity User" ;
    rdfs:comment "A user account in an identity provider." ;
    rdfs:subClassOf :Person .

:SecurityAuditEvent a owl:Class ;
    rdfs:label "Security Audit Event" ;
    rdfs:comment "One pseudonymized security-audit record from an identity, secret or edge-security system (EH-410). Identities and secret paths are keyed HMAC references, source IPs are truncated to /24 (IPv4) or /48 (IPv6), and no secret value or request/response body is ever carried (operator ruling 2026-09-24)." ;
    rdfs:subClassOf :Event .

:AuthenticationEvent a owl:Class ;
    rdfs:label "Authentication Event" ;
    rdfs:comment "An identity-provider user event: a login, logout, token refresh or failed attempt (Keycloak user events; producer: keycloak-agent)." ;
    rdfs:subClassOf :SecurityAuditEvent .

:AdminAuditEvent a owl:Class ;
    rdfs:label "Admin Audit Event" ;
    rdfs:comment "An administrative change recorded by an identity provider: a create/update/delete on a realm resource (Keycloak admin events; producer: keycloak-agent)." ;
    rdfs:subClassOf :SecurityAuditEvent .

:SecretAccessEvent a owl:Class ;
    rdfs:label "Secret Access Event" ;
    rdfs:comment "One secret-store audit entry: an operation on a (pseudonymized) secret path by a (pseudonymized) entity (OpenBao audit device; producer: openbao-mcp)." ;
    rdfs:subClassOf :SecurityAuditEvent .

:IntrusionDecision a owl:Class ;
    rdfs:label "Intrusion Decision" ;
    rdfs:comment "An edge-security remediation decision (CrowdSec ban/captcha) against a scope value; the ban target is kept whole because the decision is about exactly that address (producer: caddy-mcp)." ;
    rdfs:subClassOf :SecurityAuditEvent .
