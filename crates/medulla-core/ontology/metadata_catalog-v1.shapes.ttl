@prefix : <http://knuckles.team/kg#> .
@prefix cat: <http://knuckles.team/kg/catalog#> .
@prefix cp: <http://knuckles.team/kg/connector-pack#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Connector-backed catalog assets name exactly one connector (MEDULLA-TYPED-PACKS-R106.1).
# AgentAsset is an Agent Library asset governed by R108 and is intentionally
# outside this connector requirement.
cat:ConnectorAssetShape a sh:NodeShape ;
    sh:targetClass cat:ToolAsset, cat:PromptAsset, cat:SkillAsset, cat:DataResource, cat:Field ;
    sh:property [ sh:path cp:ofConnector ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ],
    [ sh:path cp:digest ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[0-9a-f]{64}$" ] .

# A data resource serves exactly one ontology class.
cat:DataResourceShape a sh:NodeShape ;
    sh:targetClass cat:DataResource ;
    sh:property [ sh:path cp:servesClass ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] .

# A field names exactly one ontology property.
cat:FieldShape a sh:NodeShape ;
    sh:targetClass cat:Field ;
    sh:property [ sh:path cp:servesProperty ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] .

# A system-prompt candidate names at least one task it frames (MEDULLA-DECISION-ENGINE-R814.4).
:PromptCandidateShape a sh:NodeShape ;
    sh:targetClass :PromptCandidate ;
    sh:property [ sh:path :systemPromptFor ; sh:minCount 1 ; sh:nodeKind sh:IRI ] .

# A stewardship assignment names one asset, one principal and one catalog role.
cat:StewardshipAssignmentShape a sh:NodeShape ;
    sh:targetClass cat:StewardshipAssignment ;
    sh:property [ sh:path cat:assignedTo ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ],
    [ sh:path cat:principal ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ],
    [ sh:path cat:role ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( cat:owner cat:steward cat:custodian ) ] .

# A lineage edge names both ends and a closed hop type.
cat:LineageEdgeShape a sh:NodeShape ;
    sh:targetClass cat:LineageEdge ;
    sh:property [ sh:path cat:from ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ],
    [ sh:path cat:to ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ],
    [ sh:path cat:hop ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
      sh:in ( "connector" "operation" "resource" "field" "ingest" "transform" ) ] .

# A glossary term has one preferred label and names at least one class.
cat:GlossaryTermShape a sh:NodeShape ;
    sh:targetClass cat:GlossaryTerm ;
    sh:property [ sh:path skos:prefLabel ; sh:minCount 1 ; sh:maxCount 1 ],
    [ sh:path cat:definesClass ; sh:minCount 1 ; sh:nodeKind sh:IRI ] .

# The asset flag vocabulary is closed.
cat:AssetFlagShape a sh:NodeShape ;
    sh:targetClass cat:ToolAsset, cat:PromptAsset, cat:SkillAsset, cat:DataResource, cat:Field ;
    sh:property [ sh:path cat:flag ; sh:datatype xsd:string ; sh:in ( "owner_missing" "deprecated" ) ] .
