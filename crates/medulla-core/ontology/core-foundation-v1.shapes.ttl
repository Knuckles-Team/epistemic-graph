@prefix : <http://knuckles.team/kg#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

# Core-foundation ABox shapes (MEDULLA-CQ-CONN-R074.x): an agreement must name its
# counterparty, so a legal-peripherals record without one is incomplete.

:AgreementShape a sh:NodeShape ;
    sh:description "An agreement names at least one counterparty." ;
    sh:name "Agreement Shape" ;
    sh:property [ sh:minCount 1 ;
            sh:message "An agreement must name at least one counterparty." ;
            sh:path :counterparty ] ;
    sh:targetClass :Agreement .
