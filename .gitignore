# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

/.ruff_cache/

# C extensions
*.so
*.pyd

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
# Keep the docker/wheels/ placeholder tracked — it is the COPY target in
# docker/Dockerfile so the image installs the CI-built wheel (no PyPI round-trip).
# Any actual built wheels dropped there (in CI) stay ignored.
!docker/wheels/
docker/wheels/*
!docker/wheels/.gitkeep
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Rust target directory and backups
target/
debug/
**/*.rs.bk
*.pdb
**/mutants.out*/
.idea/

# Model-generated transient scripts at root level
/test_*.py
/fix_*.py
/debug_*.py
/scratch_*.py
/temp_*.py

# Transient logs, traces, patch files, and test outputs
*.orig
*.rej
*.patch
*.log
*output*.txt
*errors*.txt
failed_tests.txt
trace.txt

# AI agent scratch (do not commit) — keep repo roots pristine
.agent/
.agents/
.agent_data/
.tmp/
.pytest_tmp/
.hypothesis/
site/

# Generated analysis output and scratch — these belong in the workspace-level
# reports/ directory, never in a package's commit history. A 3.0G build dir was
# one `git add -A` away from being committed here.
reports/
target-isolated/
target-*/
scratch/
.scratch/
*.log
*.orig
*.rej
