# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

/.ruff_cache/

# C extensions
*.so
*.pyd

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
# Per-purpose maturin --out directories. `dist/` alone does not cover them, so
# every local gate run left `dist-gates/`/`numdist-gates/` untracked in the repo
# root — the exact shape that turns a careless `git add -A` into a committed
# 1.6MB of wheels. The gates job (release.yml) writes the first pair; the
# suffix varies by purpose, so match the family rather than chasing each new one.
dist-*/
numdist-*/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
# Keep the docker/wheels/ placeholder tracked — it is the COPY target in
# docker/Dockerfile so the image installs the CI-built wheel (no PyPI round-trip).
# Any actual built wheels dropped there (in CI) stay ignored.
!docker/wheels/
docker/wheels/*
!docker/wheels/.gitkeep
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

